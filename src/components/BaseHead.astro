---
/**
 * <head> metadata, OG, canonical, favicons — included in BaseLayout.
 * Props drive per-page customization; company data fills defaults.
 */
import { company } from '@data/company';
import { url } from '@lib/utils';
import TrackingScripts from './TrackingScripts.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/images/photos/hero-home.webp',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${company.url}${ogImage}`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Preload critical fonts to prevent layout shift -->
<link rel="preload" href={url('/fonts/source-sans-3.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={url('/fonts/anton-400.woff2')} as="font" type="font/woff2" crossorigin />

<TrackingScripts />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={company.name} />
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Canonical -->
<link rel="canonical" href={canonical} />

<!-- Favicons -->
<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
<link rel="icon" href={url('/leaf-green.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/manifest.json')} />
<meta name="theme-color" content="#00863F" />
