---
/**
 * <head> metadata, OG, canonical, favicons — included in BaseLayout.
 * Props drive per-page customization; company data fills defaults.
 *
 * ogImage accepts ImageMetadata (from getPhoto / astro:assets import)
 * or a URL string. Resolved to an absolute URL via Astro.site.
 */
import type { ImageMetadata } from 'astro';
import { company } from '@data/company';
import { getPhoto } from '@lib/images';
import { url } from '@lib/utils';
import TrackingScripts from './TrackingScripts.astro';

import sourceSansFont from '../fonts/source-sans-3.woff2';
import antonFont from '../fonts/anton-400.woff2';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: ImageMetadata | string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Resolve OG image to absolute URL:
// - ImageMetadata: use .src (already base-aware) + Astro.site origin
// - URL string: resolve against Astro.site
// - Default: hero-home from the image pipeline
const resolvedImage = ogImage ?? getPhoto('hero-home.webp');
const ogSrc = typeof resolvedImage === 'string'
  ? resolvedImage
  : resolvedImage.src;
const ogImageUrl = ogSrc.startsWith('http')
  ? ogSrc
  : new URL(ogSrc, Astro.site).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

{/* Domain verification tags — rendered only when codes are set in company.ts */}
{company.verification.metaDomain && <meta name="facebook-domain-verification" content={company.verification.metaDomain} />}
{company.verification.googleSiteVerification && <meta name="google-site-verification" content={company.verification.googleSiteVerification} />}

<link rel="preload" href={sourceSansFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={antonFont} as="font" type="font/woff2" crossorigin />

<TrackingScripts />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={company.name} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={`${company.name} — ${description.slice(0, 100)}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="canonical" href={canonical} />

<link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
<link rel="icon" href={url('/leaf-green.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/manifest.json')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<meta name="theme-color" content="#111111" />
