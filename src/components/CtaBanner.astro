---
/**
 * Call-to-action banner — used near the bottom of most pages.
 */
import { company } from '@data/company';
import { url } from '@lib/utils';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'READY TO TRANSFORM YOUR <span style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.4); text-underline-offset: 6px;">LANDSCAPE?</span>',
  text = "Get a free, no-obligation estimate from Rochester's <strong>experienced landscape professionals</strong>.",
} = Astro.props;
---

<section class="py-24" style="background: linear-gradient(135deg, #3B8132 0%, #00572B 100%);">
  <div class="site-container fade-in text-center">
    <h2 class="mb-4" set:html={heading} />
    <p class="text-lg text-white/90 max-w-2xl mx-auto mb-8" set:html={text} />
    <div class="flex flex-wrap justify-center gap-4">
      <a href={url('/contact')} class="btn btn-dark btn-lg">Request Free Estimate</a>
      <a href={company.phoneHref} class="btn btn-outline btn-lg" style="border-color: rgba(255,255,255,0.5);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call Us Today
      </a>
    </div>
  </div>
</section>
