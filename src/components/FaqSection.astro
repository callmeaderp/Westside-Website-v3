---
/**
 * Reusable FAQ section — renders FAQ cards and provides data for FAQPage schema.
 * Used on service pages to add FAQ content + rich snippet eligibility.
 * Visual style matches the contact page FAQ section.
 */
import type { FaqItem } from '@data/service-content';

interface Props {
  faqs: FaqItem[];
  label?: string;
  title?: string;
}

const { faqs, label = 'Common Questions', title = 'FREQUENTLY <span class="text-green">ASKED</span>' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="py-24 section-dark">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">{label}</p>
        <h2 class="section-title" set:html={title} />
      </div>
      <div class="max-w-3xl mx-auto flex flex-col gap-6 stagger-children">
        {faqs.map((faq) => (
          <div class="p-6 rounded-xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
            <h3 class="text-base mb-3" style="font-family: var(--font-body); font-weight: 700; text-transform: none; line-height: 1.4;">{faq.question}</h3>
            <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.8;" set:html={faq.answer} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}
