---
/**
 * Site footer — 4-column grid with logo, services, company links, and contact.
 */
import { company } from '@data/company';
import { footerServices, footerCompany } from '@data/navigation';
import { url } from '@lib/utils';
---

<footer class="bg-bg-dark-alt pt-20 pb-8 border-t border-border-dark">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">

      <!-- About Column -->
      <div class="footer-about">
        <a href={url('/')} class="logo flex flex-col items-start shrink-0 no-underline mb-6">
          <img class="h-14 w-auto" src={url('/logo-cropped-white.png')} alt={company.name} width="616" height="238" />
          <span class="text-xs font-semibold tracking-[2px] uppercase -mt-0.5"
            style="font-family: var(--font-body); color: var(--color-green-bright);">
            Professional Landscape
          </span>
        </a>
        <p class="text-sm leading-relaxed mb-6" style="color: var(--color-text-muted);">
          Rochester's premier full-service landscape company. Designing, building, and maintaining beautiful outdoor spaces since {company.foundingYear}.
        </p>
        <div class="footer-social flex gap-3">
          <a href={company.social.facebook} aria-label="Facebook" target="_blank" rel="noopener"
            class="social-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={company.social.instagram} aria-label="Instagram" target="_blank" rel="noopener"
            class="social-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href={company.social.twitter} aria-label="Twitter" target="_blank" rel="noopener"
            class="social-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={company.social.google} aria-label="Google Business" target="_blank" rel="noopener"
            class="social-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Services</h4>
        <ul class="flex flex-col gap-2.5">
          {footerServices.map((link) => (
            <li><a href={url(link.href)} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Company</h4>
        <ul class="flex flex-col gap-2.5">
          {footerCompany.map((link) => (
            <li><a href={url(link.href)} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Contact Us</h4>
        <div class="flex flex-col gap-4">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-green-bright);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="text-sm" style="color: var(--color-text-muted);">
              {company.address.street}<br />{company.address.city}, {company.address.state} {company.address.zip}
            </span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-green-bright);"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.8.36 1.58.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.83.28 1.61.51 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={company.phoneHref} class="footer-link">{company.phone}</a>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-green-bright);"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${company.email}`} class="footer-link">{company.email}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom border-t border-border-dark pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs" style="color: var(--color-text-muted);">
        &copy; {new Date().getFullYear()} {company.legalName}. All rights reserved.
      </p>
      <p class="text-xs">
        <a href={url('/privacy')} class="footer-link text-xs">Privacy Policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Footer headings */
  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    color: var(--color-text-white);
  }

  /* Footer links — hover to green like V2 */
  .footer-link {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .footer-link:hover {
    color: var(--color-green-bright);
  }

  /* Social icons — bordered circles with gradient hover */
  .social-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .social-icon:hover {
    background: linear-gradient(135deg, #6CC551 0%, #00863F 100%);
    border-color: transparent;
    color: var(--color-text-white);
  }

  /* Contact items */
  .footer-col .flex.items-start span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
