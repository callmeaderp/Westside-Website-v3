---
/**
 * Site header with navigation, logo, services dropdown, and mobile menu.
 * Active link is determined automatically from current URL.
 */
import { mainNav } from '@data/navigation';
import { url } from '@lib/utils';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

function isActive(href: string): boolean {
  const fullHref = url(href);
  if (href === '/') return currentPath === base || currentPath === base.slice(0, -1);
  return currentPath.startsWith(fullHref);
}
---

<header class="site-header sticky top-0 z-50 min-h-[var(--header-height)]">
  <div class="header-inner max-w-[1400px] mx-auto px-5 md:px-8 py-3 lg:py-5 flex items-center justify-between">

    <!-- Logo -->
    <div class="logo-group flex items-center gap-3 md:gap-5">
      <a href={url('/')} class="logo flex flex-col items-start shrink-0 no-underline">
        <img
          class="logo-mark h-7 sm:h-8 lg:h-9 w-auto"
          src={url('/logo-cropped-white.png')}
          alt="Westside Professional Landscape"
          width="616"
          height="238"
        />
        <span class="logo-tagline text-[10px] sm:text-xs font-semibold tracking-[1.5px] sm:tracking-[2px] uppercase -mt-0.5"
          style="font-family: var(--font-body); color: var(--color-green-bright);">Professional Landscape</span>
      </a>
      <a
        href="https://www.synlawn.com/location/western-new-york/"
        class="partner-logo flex items-center opacity-60 hover:opacity-100 transition-opacity pl-3 md:pl-5"
        style="border-left: 1px solid rgba(255, 255, 255, 0.15);"
        target="_blank"
        rel="noopener"
        aria-label="Authorized SYNLawn Dealer"
      >
        <img src={url('/synlawn-logo.svg')} alt="SYNLawn" width="120" height="23" class="h-4 sm:h-5 md:h-7 w-auto" />
      </a>
    </div>

    <!-- Navigation -->
    <nav class="main-nav hidden lg:flex items-center gap-1" id="main-nav">
      {mainNav.map((item) => (
        item.children ? (
          <div class="nav-dropdown relative group">
            <a
              href={url(item.href)}
              class:list={[
                'px-3 py-2 text-sm font-semibold uppercase tracking-wider transition-colors',
                isActive(item.href) ? 'text-green-bright active-link' : 'text-text-light hover:text-white',
              ]}
            >
              {item.label}
            </a>
            <div class="dropdown-menu absolute top-full left-0 bg-bg-dark-elevated border border-border-dark rounded-lg py-2 min-w-[220px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-lg">
              {item.children.map((child) => (
                <a
                  href={url(child.href)}
                  class:list={[
                    'block px-4 py-2 text-sm transition-colors',
                    isActive(child.href) ? 'text-green-bright' : 'text-text-light hover:text-white hover:bg-white/5',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={url(item.href)}
            class:list={[
              'px-3 py-2 text-sm font-semibold uppercase tracking-wider transition-colors',
              isActive(item.href) ? 'text-green-bright active-link' : 'text-text-light hover:text-white',
            ]}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <!-- Header CTA -->
    <div class="header-cta hidden lg:block">
      <a href={url('/contact')} class="btn btn-primary btn-sm">Get a Free Estimate</a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button type="button" class="menu-toggle lg:hidden flex flex-col gap-1.5 p-2 cursor-pointer" id="menu-toggle" aria-label="Toggle menu">
      <span class="block w-6 h-0.5 bg-white transition-transform duration-200"></span>
      <span class="block w-6 h-0.5 bg-white transition-opacity duration-200"></span>
      <span class="block w-6 h-0.5 bg-white transition-transform duration-200"></span>
    </button>
  </div>

  <!-- Mobile Nav (hidden by default, toggled via JS) -->
  <nav class="mobile-nav hidden lg:hidden bg-bg-dark border-t border-border-dark" id="mobile-nav">
    <div class="max-w-[1400px] mx-auto px-5 md:px-8 py-6 flex flex-col gap-1">
      {mainNav.map((item) => (
        item.children ? (
          <div class="mobile-dropdown">
            <div class="dropdown-row flex items-stretch cursor-pointer">
              <a
                href={url(item.href)}
                class:list={[
                  'shrink-0 py-3 pr-2 pl-3 -ml-3 text-base font-semibold uppercase tracking-wider flex items-center rounded-lg transition-all duration-200 hover:bg-white/5 hover:translate-x-1 active:bg-white/10 active:scale-[0.98]',
                  isActive(item.href) ? 'text-green-bright' : 'text-text-light hover:text-white',
                ]}
              >
                {item.label}
              </a>
              <button type="button" class="dropdown-arrow flex-1 flex items-center justify-end py-3 px-4 -mr-4 text-text-muted hover:text-white active:text-white ml-4 rounded-r-lg transition-all duration-200 hover:bg-white/5 active:bg-white/10 active:scale-[0.97]" aria-label="Toggle submenu"
                style="border-left: 1px solid rgba(255,255,255,0.10); margin-top: 8px; margin-bottom: 8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  class="transition-transform duration-300">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
            </div>
            <div class="mobile-submenu pl-4 pt-1 pb-2 flex flex-col gap-1 overflow-hidden"
              style="max-height: 0; opacity: 0; transition: max-height 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease; mask-image: linear-gradient(to bottom, transparent, black 10px, black calc(100% - 10px), transparent); -webkit-mask-image: linear-gradient(to bottom, transparent, black 10px, black calc(100% - 10px), transparent);">
              {item.children.map((child) => (
                <a
                  href={url(child.href)}
                  class:list={[
                    'py-2 px-3 -ml-3 text-sm rounded-lg transition-all duration-200 hover:bg-white/5 hover:translate-x-1 active:bg-white/10 active:scale-[0.98]',
                    isActive(child.href) ? 'text-green-bright' : 'text-text-muted hover:text-white',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={url(item.href)}
            class:list={[
              'py-3 px-3 -ml-3 text-base font-semibold uppercase tracking-wider rounded-lg transition-all duration-200 hover:bg-white/5 hover:translate-x-1 active:bg-white/10 active:scale-[0.98]',
              isActive(item.href) ? 'text-green-bright' : 'text-text-light hover:text-white',
            ]}
          >
            {item.label}
          </a>
        )
      ))}
      <a href={url('/contact')} class="btn btn-primary btn-md mt-4 w-full text-center">Get a Free Estimate</a>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  menuToggle?.addEventListener('click', () => {
    const isOpen = !mobileNav?.classList.contains('hidden');
    mobileNav?.classList.toggle('hidden');
    menuToggle.classList.toggle('active');
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Mobile dropdown: animated slide-down with staggered children
  function openSubmenu(submenu: HTMLElement, arrow: HTMLElement | null) {
    const items = submenu.querySelectorAll(':scope > a') as NodeListOf<HTMLElement>;
    // Reset children before measuring
    items.forEach((item) => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(-8px)';
      item.style.transition = 'none';
    });
    // Set transition to bouncy spring for expansion
    submenu.style.transition = 'max-height 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease';
    submenu.style.maxHeight = submenu.scrollHeight + 'px';
    submenu.style.opacity = '1';
    arrow?.querySelector('svg')?.classList.add('rotate-180');
    // Stagger children in
    requestAnimationFrame(() => {
      items.forEach((item, i) => {
        item.style.transition = `opacity 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) ${i * 35}ms, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) ${i * 35}ms`;
        item.style.opacity = '1';
        item.style.transform = 'translateY(0)';
      });
    });
  }

  function closeSubmenu(submenu: HTMLElement, arrow: HTMLElement | null) {
    const items = submenu.querySelectorAll(':scope > a') as NodeListOf<HTMLElement>;
    items.forEach((item) => {
      item.style.transition = 'opacity 0.15s ease, transform 0.15s ease';
      item.style.opacity = '0';
      item.style.transform = 'translateY(-4px)';
    });
    // Snappy retract — faster ease-out, no bounce
    submenu.style.transition = 'max-height 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease';
    submenu.style.maxHeight = '0';
    submenu.style.opacity = '0';
    arrow?.querySelector('svg')?.classList.remove('rotate-180');
  }

  function isSubmenuOpen(submenu: HTMLElement): boolean {
    return submenu.style.maxHeight !== '0' && submenu.style.maxHeight !== '0px' && submenu.style.maxHeight !== '';
  }

  document.querySelectorAll('.mobile-dropdown').forEach((dropdown) => {
    const submenu = dropdown.querySelector('.mobile-submenu') as HTMLElement;
    const arrow = dropdown.querySelector('.dropdown-arrow') as HTMLButtonElement;

    // Parent link: always navigates to the Services page (no interception)
    // Chevron area: toggles submenu open/closed
    arrow?.addEventListener('click', () => {
      if (isSubmenuOpen(submenu)) {
        closeSubmenu(submenu, arrow);
      } else {
        openSubmenu(submenu, arrow);
      }
    });
  });

  // Close mobile nav on link click (skip parent links that are opening their submenu)
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (e.defaultPrevented) return;
      mobileNav?.classList.add('hidden');
      menuToggle?.classList.remove('active');
      document.body.style.overflow = '';
    });
  });

  // Header scroll effect — class toggle (avoids per-frame inline style recalc)
  const header = document.querySelector('.site-header') as HTMLElement;
  let scrolled = false;
  function syncHeaderScroll() {
    const next = window.scrollY > 50;
    if (next !== scrolled) {
      scrolled = next;
      header?.classList.toggle('is-scrolled', next);
    }
  }
  if (header) {
    syncHeaderScroll();
    window.addEventListener('scroll', syncHeaderScroll, { passive: true });

    // Mobile visual viewport fix: when the address bar shows/hides, the
    // visual viewport shifts relative to the layout viewport. sticky top:0
    // anchors to the layout viewport — which can be above the visible area.
    // We nudge `top` to track the visual viewport. CSS transition handles
    // the smoothing with a spring curve, so only a minimal JS bridge is needed.
    const vv = window.visualViewport;
    if (vv) {
      const sync = () => { header!.style.top = `${vv!.offsetTop}px`; };
      vv.addEventListener('scroll', sync);
      vv.addEventListener('resize', sync);
    }
  }

  // Enhanced debug overlay — ?debugHeader for comprehensive live metrics
  // Positioned at BOTTOM to avoid being clipped by the same top-edge issue
  if (header && location.search.includes('debugHeader')) {
    // Red outline on header to show its actual CSS box bounds
    header.style.outline = '2px solid red';
    header.style.outlineOffset = '-2px';

    const box = document.createElement('pre');
    Object.assign(box.style, {
      position: 'fixed', bottom: '0', left: '0', right: '0', zIndex: '9999',
      padding: '6px 10px', background: 'rgba(0,0,0,.92)', color: '#7CFC00',
      font: '11px/1.4 monospace', pointerEvents: 'none',
    });
    document.body.appendChild(box);
    const vv = window.visualViewport;

    // rAF loop — catches transient states that events miss
    (function renderDebug() {
      const hr = header.getBoundingClientRect();
      const cs = getComputedStyle(header);
      box.textContent = [
        `scroll: ${Math.round(window.scrollY)}  |  pos: ${cs.position}  top-css: ${cs.top}`,
        `innerH: ${window.innerHeight}  vv.h: ${vv ? vv.height.toFixed(0) : '-'}  diff: ${vv ? (window.innerHeight - vv.height).toFixed(0) : '-'}`,
        `vv.offTop: ${vv ? vv.offsetTop.toFixed(1) : '-'}  vv.pageTop: ${vv ? vv.pageTop.toFixed(0) : '-'}`,
        `hdr rect → top: ${hr.top.toFixed(1)}  bot: ${hr.bottom.toFixed(1)}  h: ${hr.height.toFixed(1)}`,
        `body overflowX: ${getComputedStyle(document.body).overflowX}`,
      ].join('\n');
      requestAnimationFrame(renderDebug);
    })();
  }
</script>

<style>
  /* Header background + visual viewport spring transition.
     The spring curve (overshoot at 1.35) gives the header a subtle
     bounce-settle when the mobile address bar shows/hides. */
  .site-header {
    background-color: rgba(17, 17, 17, 0.92);
    transition: top 500ms cubic-bezier(0.34, 1.8, 0.64, 1),
                background-color 160ms ease;
  }
  /* Dark shield above header — covers the gap when the header slides
     down to track the visual viewport during address bar transitions.
     Invisible at rest (above the viewport edge). */
  .site-header::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    height: 24px;
    background-color: rgb(17, 17, 17);
  }
  .site-header.is-scrolled {
    background-color: rgba(17, 17, 17, 0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }

  /* Active/hover green gradient underline on desktop nav links */
  .main-nav > a,
  .main-nav .nav-dropdown > a {
    position: relative;
  }

  .main-nav > a::after,
  .main-nav .nav-dropdown > a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(135deg, #6CC551 0%, #00863F 100%);
    transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .main-nav > a:hover::after,
  .main-nav .nav-dropdown > a:hover::after,
  .main-nav > a.active-link::after,
  .main-nav .nav-dropdown > a.active-link::after {
    width: 100%;
  }
</style>
