---
/**
 * Reusable hero section — supports full-height (homepage) and page-hero variants.
 * The hero-bg image gets parallax via client-side JS.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '@lib/utils';

interface Props {
  label?: string;
  heading: string;
  intro?: string;
  image?: ImageMetadata;
  variant?: 'full' | 'page' | 'utility';
  buttons?: Array<{ text: string; href: string; style: 'primary' | 'dark' | 'outline' }>;
}

const { label, heading, intro, image, variant = 'page', buttons } = Astro.props;

const heroClasses = {
  // pt clears the sticky header (main is pulled up under it via negative
  // margin in BaseLayout); pb clears the absolute scroll cue. Without these,
  // flex centering lets tall content (small viewports, large font scaling)
  // slide under the header and collide with the cue.
  full: 'min-h-[100svh] flex items-center relative overflow-hidden pt-[calc(var(--header-height)+2rem)] pb-28',
  page: 'pt-40 pb-24 relative overflow-hidden',
  utility: 'pt-36 pb-16 relative overflow-hidden bg-bg-dark-alt',
};
---

<section class:list={['hero', heroClasses[variant]]}>
  {image && (
    <div class="hero-bg absolute inset-0">
      <Image
        src={image}
        alt=""
        class="w-full h-full object-cover"
        widths={[768, 1280, 1536]}
        sizes="100vw"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.4) 100%);"></div>
    </div>
  )}

  <div class="accent-line-corner absolute top-0 left-0 w-px h-24 bg-gradient-to-b from-green-bright/60 to-transparent hidden md:block ml-8"></div>

  <div class="site-container relative z-10">
    {label && <p class="section-label">{label}</p>}
    <h1 class="max-w-4xl mb-6" set:html={heading} />
    {intro && <p class="section-subtitle max-w-2xl" set:html={intro} />}

    {buttons && buttons.length > 0 && (
      <div class="flex flex-wrap gap-4 mt-8">
        {buttons.map((btn) => (
          <a href={url(btn.href)} class={`btn btn-lg btn-${btn.style}`}>
            {btn.text}
          </a>
        ))}
      </div>
    )}

    <slot />
  </div>

  {variant === 'full' && (
    <div class="scroll-cue absolute left-1/2 -translate-x-1/2 bottom-8 z-10 flex flex-col items-center gap-2 opacity-0 transition-opacity duration-500">
      <span class="scroll-cue__label text-[0.65rem] font-semibold uppercase tracking-[0.28em]" style="color: var(--color-text-muted);">Scroll</span>
      <span class="scroll-cue__icon flex flex-col items-center gap-0.5" aria-hidden="true">
        <span class="block w-2.5 h-2.5 rotate-45 border-r-2 border-b-2" style="border-color: rgba(108, 197, 81, 0.92);"></span>
        <span class="block w-2.5 h-2.5 -mt-1 rotate-45 border-r-2 border-b-2 opacity-70" style="border-color: rgba(108, 197, 81, 0.92);"></span>
      </span>
    </div>
  )}
</section>
