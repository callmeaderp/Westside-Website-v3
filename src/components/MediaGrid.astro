---
/**
 * Photo/video grid used by /gallery/ and the service-page "From our work"
 * strips. Each tile is a button that MediaLightbox opens; the lightbox reads
 * the data-* attributes, so keep them in sync with MediaLightbox.astro.
 *
 * `gallery` is the dense masonry layout with per-item span hints (reset when a
 * filter is active); `strip` is a short, even three-up row for service pages.
 */
import { Image, getImage } from 'astro:assets';
import type { GalleryItem } from '@data/gallery';
import { getPhoto } from '@lib/images';

interface Props {
  items: GalleryItem[];
  variant?: 'gallery' | 'strip';
  id?: string;
}

const { items, variant = 'gallery', id } = Astro.props;

// Pre-generate the larger lightbox rendition. Portrait frames are capped by
// height-equivalent width so the lightbox never ships a 2,000 px tall photo.
const tiles = await Promise.all(
  items.map(async (item) => {
    const photo = getPhoto(item.image);
    const portrait = photo.height > photo.width;
    const full = await getImage({ src: photo, width: Math.min(photo.width, portrait ? 1100 : 1600) });
    return { ...item, photo, portrait, fullSrc: full.src };
  })
);

const sizes =
  variant === 'strip'
    ? '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 400px'
    : '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw';
---

<div class:list={['media-grid', `media-grid--${variant}`]} id={id} data-lightbox-group>
  {tiles.map((item) => (
    <button
      type="button"
      class:list={['media-item', variant === 'gallery' && item.span && `span-${item.span}`]}
      data-lightbox-item
      data-category={item.category}
      data-kind={item.video ? 'video' : 'photo'}
      data-full={item.fullSrc}
      data-video={item.video}
      data-tag={item.tag}
      data-caption={item.caption}
    >
      <Image
        src={item.photo}
        alt={item.alt}
        class="media-image"
        loading="lazy"
        widths={[400, 600, 900]}
        sizes={sizes}
      />
      {item.video && (
        <span class="media-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
      )}
      <span class="media-overlay">
        <span class="media-tag">{item.video && <span class="sr-only">Video. </span>}{item.tag}</span>
        <span class="media-caption">{item.caption}</span>
      </span>
    </button>
  ))}
</div>

<style>
  .media-grid {
    display: grid;
    gap: 6px;
  }

  /* Dense masonry for the full gallery. Span hints only apply unfiltered. */
  .media-grid--gallery {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 250px;
    grid-auto-flow: dense;
  }

  .media-grid--gallery .span-wide { grid-column: span 2; }
  .media-grid--gallery .span-tall { grid-row: span 2; }
  .media-grid--gallery .span-large { grid-column: span 2; grid-row: span 2; }

  .media-grid--gallery.filtered .media-item {
    grid-column: span 1;
    grid-row: span 1;
  }

  .media-grid--strip {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 230px;
  }

  .media-item {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    transition: opacity 0.3s ease;
    appearance: none;
    border: none;
    padding: 0;
    background: #111;
    text-align: left;
    color: inherit;
    font: inherit;
  }

  .media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .media-item:hover .media-image,
  .media-item:focus-visible .media-image {
    transform: scale(1.05);
  }

  .media-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.85);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .media-item:hover .media-play,
  .media-item:focus-visible .media-play {
    background: linear-gradient(135deg, #6cc551 0%, #00863f 100%);
    transform: scale(1.06);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.1rem 1.25rem;
  }

  .media-item:hover .media-overlay,
  .media-item:focus-visible .media-overlay {
    opacity: 1;
  }

  .media-tag {
    display: block;
    font-size: 0.75rem;
    color: var(--color-green-bright);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .media-caption {
    display: block;
    font-weight: 600;
    color: var(--color-text-white);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  /* Touch devices have no hover, so captions stay visible. */
  @media (hover: none) {
    .media-overlay {
      opacity: 1;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, transparent 65%);
    }
  }

  @media (max-width: 1024px) {
    .media-grid--strip {
      grid-auto-rows: 200px;
    }
  }

  @media (max-width: 768px) {
    .media-grid--gallery {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 190px;
      gap: 4px;
    }
    .media-grid--gallery .span-large {
      grid-column: span 2;
      grid-row: span 1;
    }
    .media-grid--gallery .span-tall {
      grid-row: span 2;
    }
  }

  @media (max-width: 640px) {
    .media-grid--strip {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
      gap: 4px;
    }
    .media-caption {
      font-size: 0.85rem;
    }
    .media-play {
      width: 46px;
      height: 46px;
      margin: -23px 0 0 -23px;
    }
  }

  @media (max-width: 480px) {
    .media-grid--gallery {
      grid-template-columns: 1fr;
      grid-auto-rows: 230px;
    }
    .media-grid--gallery .media-item {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
