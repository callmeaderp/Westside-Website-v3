---
/**
 * Shared photo/video lightbox for MediaGrid. Render it once per page; it binds
 * to every [data-lightbox-group] and pages through the tiles that are visible
 * in the opened group (so it follows the gallery's active filter).
 */
---

<div id="media-lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo and video viewer" aria-hidden="true">
  <button type="button" class="lightbox-close" aria-label="Close viewer">&times;</button>
  <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <button type="button" class="lightbox-nav lightbox-next" aria-label="Next">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <figure class="lightbox-content">
    <img class="lightbox-img" src="" alt="" width="1600" height="1200" />
    <video class="lightbox-video" controls playsinline muted loop preload="none" hidden></video>
    <figcaption class="lightbox-caption">
      <span class="lightbox-tag"></span>
      <span class="lightbox-text"></span>
      <span class="lightbox-count"></span>
    </figcaption>
  </figure>
</div>

<script>
  const lightbox = document.getElementById('media-lightbox');

  if (lightbox) {
    const img = lightbox.querySelector('.lightbox-img') as HTMLImageElement;
    const video = lightbox.querySelector('.lightbox-video') as HTMLVideoElement;
    const tagEl = lightbox.querySelector('.lightbox-tag') as HTMLElement;
    const textEl = lightbox.querySelector('.lightbox-text') as HTMLElement;
    const countEl = lightbox.querySelector('.lightbox-count') as HTMLElement;
    const closeBtn = lightbox.querySelector('.lightbox-close') as HTMLButtonElement;
    const prevBtn = lightbox.querySelector('.lightbox-prev') as HTMLButtonElement;
    const nextBtn = lightbox.querySelector('.lightbox-next') as HTMLButtonElement;

    let items: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    // Tiles hidden by a gallery filter have no layout box; skip them.
    const visibleTiles = (group: Element) =>
      Array.from(group.querySelectorAll<HTMLElement>('[data-lightbox-item]')).filter(
        (el) => el.offsetParent !== null
      );

    function stopVideo() {
      video.pause();
      video.removeAttribute('src');
      video.removeAttribute('poster');
      video.load(); // aborts any in-flight download
      video.hidden = true;
    }

    function show(i: number) {
      if (items.length === 0) return;
      index = (i + items.length) % items.length;
      const tile = items[index];
      const thumb = tile.querySelector('img');
      const caption = tile.dataset.caption ?? '';

      tagEl.textContent = tile.dataset.tag ?? '';
      textEl.textContent = caption;
      countEl.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
      prevBtn.hidden = nextBtn.hidden = items.length < 2;

      if (tile.dataset.video) {
        img.hidden = true;
        img.removeAttribute('src');
        video.hidden = false;
        video.poster = tile.dataset.full || thumb?.currentSrc || '';
        video.src = tile.dataset.video;
        video.setAttribute('aria-label', thumb?.alt || caption);
        video.play().catch(() => {
          /* Autoplay can be refused; the controls remain available. */
        });
      } else {
        stopVideo();
        img.hidden = false;
        img.classList.remove('loaded');
        img.onload = () => img.classList.add('loaded');
        img.src = tile.dataset.full || thumb?.currentSrc || '';
        img.alt = thumb?.alt || caption;
        if (img.complete) img.classList.add('loaded');
      }
    }

    function open(tile: HTMLElement) {
      const group = tile.closest('[data-lightbox-group]');
      if (!group) return;
      items = visibleTiles(group);
      opener = tile;
      lightbox!.classList.add('active');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      show(Math.max(0, items.indexOf(tile)));
      requestAnimationFrame(() => closeBtn.focus());
    }

    function close() {
      stopVideo();
      lightbox!.classList.remove('active');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      opener?.focus();
      opener = null;
    }

    // Native <button> tiles fire click on Enter/Space.
    document.querySelectorAll<HTMLElement>('[data-lightbox-item]').forEach((tile) => {
      tile.addEventListener('click', () => open(tile));
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));

    // Clicking the dark backdrop (not the media or controls) closes.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    let touchX: number | null = null;
    lightbox.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      touchX = null;
      // Leave horizontal drags on the video scrubber alone.
      if ((e.target as HTMLElement).closest('video')) return;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });

    const FOCUSABLE = 'button:not([disabled]):not([hidden]), video[controls]:not([hidden]), [tabindex]:not([tabindex="-1"])';

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'ArrowRight') { show(index + 1); return; }
      if (e.key === 'ArrowLeft') { show(index - 1); return; }
      if (e.key !== 'Tab') return;

      const focusable = Array.from(lightbox.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && (active === first || !lightbox.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || !lightbox.contains(active))) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-content {
    margin: 0;
    max-width: min(92vw, 1600px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-img,
  .lightbox-video {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    background: #000;
  }

  .lightbox-video {
    width: min(92vw, 1600px);
    aspect-ratio: 16 / 9;
  }

  .lightbox-img {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lightbox-img.loaded {
    opacity: 1;
  }

  .lightbox-img[hidden],
  .lightbox-video[hidden] {
    display: none;
  }

  .lightbox-caption {
    margin-top: 1rem;
    text-align: center;
    color: var(--color-text-light);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 60ch;
  }

  .lightbox-tag {
    font-size: 0.75rem;
    color: var(--color-green-bright);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .lightbox-text {
    font-size: 1rem;
  }

  .lightbox-count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    z-index: 10000;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .lightbox-close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    font-size: 1.5rem;
  }

  .lightbox-nav {
    top: 50%;
    width: 52px;
    height: 52px;
    margin-top: -26px;
  }

  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }

  .lightbox-nav[hidden] {
    display: none;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.75);
  }

  @media (max-width: 768px) {
    .lightbox-nav {
      top: auto;
      bottom: 18px;
      margin-top: 0;
      width: 46px;
      height: 46px;
    }
    .lightbox-prev { left: calc(50% - 58px); }
    .lightbox-next { right: calc(50% - 58px); }
    .lightbox-content { max-height: 80vh; }
    .lightbox-img,
    .lightbox-video { max-height: 66vh; }
  }
</style>
