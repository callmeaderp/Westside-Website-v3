---
/**
 * Analytics and tracking scripts — included in BaseLayout <head>.
 * GA4 + Google Ads + Meta Pixel + Clarity. Centralized so tracking IDs are
 * never scattered across pages.
 *
 * Internal traffic filtering: A Cloudflare Transform Rule sets a
 * `_wpl_internal=1` cookie when the visitor IP matches the Westside office.
 * When that cookie is present, ALL tracking is suppressed — no GA4, no Ads,
 * no Meta Pixel, no Clarity. Managed via Cloudflare API, no UI needed.
 *
 * Google Ads conversion tracking loads alongside GA4 via the same gtag
 * instance — just an additional `gtag('config', 'AW-...')` call. When
 * `company.tracking.googleAdsId` is empty, no Ads code is emitted.
 *
 * NOTE: The Meta Pixel <noscript> fallback lives in BaseLayout.astro <body>,
 * not here, because <noscript><img> is invalid inside <head> per HTML spec.
 */
import { company } from '@data/company';

const googleAdsId = company.tracking.googleAdsId;
const googleAdsPhoneLabel = googleAdsId && company.tracking.googleAdsPhoneLabel
  ? `${googleAdsId}/${company.tracking.googleAdsPhoneLabel}`
  : '';
const clarityId = company.tracking.clarity;
---

<!-- Internal traffic gate — Cloudflare sets _wpl_internal cookie for office IPs -->
<script is:inline>
  window.__wplInternal = document.cookie.indexOf('_wpl_internal=1') !== -1;
</script>

<!-- Google tag (gtag.js) -->
<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${company.tracking.ga4}`}
></script>
<script is:inline define:vars={{ ga4Id: company.tracking.ga4, adsId: googleAdsId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  if (!window.__wplInternal) {
    gtag('js', new Date());
    gtag('config', ga4Id);
    if (adsId) gtag('config', adsId);
  }
</script>

<!-- Meta Pixel Code -->
<script is:inline define:vars={{ pixelId: company.tracking.metaPixel }}>
  if (!window.__wplInternal) {
    !(function (f, b, e, v, n, t, s) {
      if (f.fbq) return;
      n = f.fbq = function () {
        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
      };
      if (!f._fbq) f._fbq = n;
      n.push = n;
      n.loaded = !0;
      n.version = '2.0';
      n.queue = [];
      t = b.createElement(e);
      t.async = !0;
      t.src = v;
      s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s);
    })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', pixelId);
    fbq('track', 'PageView');
  }
</script>

{/* Microsoft Clarity — heatmaps + session recording (free) */}
{clarityId && (
<script is:inline define:vars={{ cid: clarityId }}>
  if (!window.__wplInternal) {
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', cid);
  }
</script>
)}

<!-- Phone call click tracking — fires GA4 + Google Ads + Meta events on any tel: link -->
<script is:inline define:vars={{ adsPhoneSendTo: googleAdsPhoneLabel }}>
  document.addEventListener('click', function (e) {
    if (window.__wplInternal) return;
    var link = e.target.closest('a[href^="tel:"]');
    if (!link) return;
    var phone = link.getAttribute('href').replace('tel:', '');
    if (typeof gtag === 'function') {
      gtag('event', 'phone_call_click', {
        event_category: 'engagement',
        phone_number: phone,
      });
      if (adsPhoneSendTo) {
        gtag('event', 'conversion', { send_to: adsPhoneSendTo, value: 25.0, currency: 'USD' });
      }
    }
    if (typeof fbq === 'function') {
      fbq('track', 'Contact');
    }
  });
</script>
