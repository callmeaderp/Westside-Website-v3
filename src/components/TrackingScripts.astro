---
/** Central browser attribution and conversion tracking. Production loads tags
 * immediately for ad-platform detection. Recruiting never emits customer goals.
 * Local/preview hosts load no analytics; internal production visits are GA4-only.
 */
import { company } from '@data/company';
const ga4Id = company.tracking.ga4;
const googleAdsId = company.tracking.googleAdsId;
const adsFormSendTo = googleAdsId && company.tracking.googleAdsFormLabel ? `${googleAdsId}/${company.tracking.googleAdsFormLabel}` : '';
const adsPhoneSendTo = googleAdsId && company.tracking.googleAdsPhoneLabel ? `${googleAdsId}/${company.tracking.googleAdsPhoneLabel}` : '';
const microsoftUetId = company.tracking.microsoftUet;
const metaPixelId = company.tracking.metaPixel;
---

<!-- First touch survives navigation and the legacy career redirect. -->
<script is:inline>
  (function () {
    var KEY = '__wpl_attribution';
    var FIELDS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'msclkid'];
    function read() {
      try {
        var raw = sessionStorage.getItem(KEY);
        var value = raw ? JSON.parse(raw) : null;
        return value && typeof value === 'object' && !Array.isArray(value) ? value : null;
      } catch (_) { return null; }
    }
    var stored = read();
    var params = new URLSearchParams(window.location.search);
    if (!stored) {
      stored = {
        landing_page: (window.location.pathname + window.location.search).slice(0, 300),
        referrer: document.referrer.slice(0, 300),
      };
      FIELDS.forEach(function (key) {
        var value = params.get(key);
        if (value) stored[key] = value.slice(0, 200);
      });
      try { sessionStorage.setItem(KEY, JSON.stringify(stored)); } catch (_) { /* Storage may be unavailable. */ }
    }
    window.__wplAttribution = function () { return read() || stored || {}; };
    window.__wplCareerPage = /^\/careers?(?:\/|$)/i.test(window.location.pathname) ||
      ['careers', 'career', 'career inquiry', 'career-inquiry'].includes((params.get('service') || '').toLowerCase());
    window.__wplTrackingEnabled = window.location.protocol === 'https:' &&
      ['westsideprolandscape.com', 'www.westsideprolandscape.com'].includes(window.location.hostname);
    window.__wplInternal = document.cookie.split(';').some(function (cookie) { return cookie.trim() === '_wpl_internal=1'; });
  })();
</script>

<!-- Queue stubs remain callable on preview, but no tracking is dispatched there. -->
<script is:inline define:vars={{ ga4Id, googleAdsId, metaPixelId }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { if (window.__wplTrackingEnabled) window.dataLayer.push(arguments); };
  if (!window.fbq) {
    var n = window.fbq = function () {
      if (!window.__wplTrackingEnabled || window.__wplInternal || window.__wplCareerPage) return;
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    window._fbq = n;
    n.push = n;
    n.loaded = false;
    n.version = '2.0';
    n.queue = [];
  }
  if (window.__wplTrackingEnabled) {
    if (window.__wplInternal) gtag('set', { traffic_type: 'internal' });
    gtag('js', new Date());
    gtag('config', ga4Id);
    if (!window.__wplInternal && !window.__wplCareerPage) {
      if (googleAdsId) gtag('config', googleAdsId);
      if (metaPixelId) { fbq('init', metaPixelId); fbq('track', 'PageView'); }
    }
  }
</script>

<script is:inline define:vars={{ ga4Id, metaPixelId, microsoftUetId }}>
  (function () {
    if (!window.__wplTrackingEnabled) return;
    var gtagScript = document.createElement('script');
    gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    gtagScript.async = true;
    document.head.appendChild(gtagScript);
    if (window.__wplInternal || window.__wplCareerPage) return;
    if (metaPixelId) {
      var fbScript = document.createElement('script');
      fbScript.src = 'https://connect.facebook.net/en_US/fbevents.js';
      fbScript.async = true;
      document.head.appendChild(fbScript);
    }
    if (microsoftUetId) {
      window.uetq = window.uetq || [];
      var uetScript = document.createElement('script');
      uetScript.src = 'https://bat.bing.com/bat.js';
      uetScript.async = true;
      uetScript.onload = uetScript.onreadystatechange = function () {
        var state = this.readyState;
        if (state && state !== 'loaded' && state !== 'complete') return;
        var options = { ti: microsoftUetId, enableAutoSpaTracking: true };
        options.q = window.uetq;
        window.uetq = new window.UET(options);
        window.uetq.push('pageLoad');
        uetScript.onload = uetScript.onreadystatechange = null;
      };
      document.head.appendChild(uetScript);
    }
  })();
</script>

<!-- Called only after /api/contact/ accepts the form. Never pass applicant PII to analytics. -->
<script is:inline define:vars={{ adsFormSendTo }}>
  window.__wplTrackFormSuccess = function (payload, eventId) {
    if (!window.__wplTrackingEnabled) return;
    if (payload.service === 'Career Inquiry') {
      gtag('event', 'career_application_submit', { event_category: 'recruiting', form_name: 'careers' });
      return;
    }
    var attribution = payload.attribution || {};
    gtag('event', 'form_submit', {
      event_category: 'engagement', form_name: 'contact', form_type: 'estimate_request',
      service_interest: String(payload.service || 'Not specified'),
      how_heard: String(payload.howHeard || 'Not specified'),
      property_type: String(payload.propertyType || 'Not specified'),
      project_type: String(payload.projectType || 'Not specified'),
      budget_band: String(payload.budget || 'Not specified'),
      project_timing: String(payload.timing || 'Not specified'),
      lead_utm_source: attribution.utm_source || 'direct',
      lead_utm_medium: attribution.utm_medium || 'none',
      lead_utm_campaign: attribution.utm_campaign || 'none',
    });
    if (window.__wplInternal) return;
    if (window.uetq) window.uetq.push('event', 'request_quote', {
      event_category: 'lead', event_label: 'estimate_request', event_value: 50, revenue_value: 50, currency: 'USD',
    });
    if (adsFormSendTo) gtag('event', 'conversion', { send_to: adsFormSendTo, value: 50, currency: 'USD' });
    fbq('track', 'Lead', {
      service_interest: String(payload.service || 'Not specified'),
      property_type: String(payload.propertyType || 'Not specified'),
      project_type: String(payload.projectType || 'Not specified'),
      budget_band: String(payload.budget || 'Not specified'),
    }, { eventID: eventId });
  };
</script>

<script is:inline define:vars={{ adsPhoneSendTo }}>
  function __wplReadCookie(name) {
    var parts = document.cookie ? document.cookie.split(';') : [];
    for (var i = 0; i < parts.length; i++) {
      var kv = parts[i].trim().split('=');
      if (kv[0] === name) { try { return decodeURIComponent(kv.slice(1).join('=')); } catch (_) { return ''; } }
    }
    return '';
  }
  document.addEventListener('click', function (event) {
    var link = event.target instanceof Element ? event.target.closest('a[href^="tel:"]') : null;
    if (!link || !window.__wplTrackingEnabled) return;
    var career = window.__wplCareerPage || link.dataset.contactPurpose === 'career' ||
      document.querySelector('#service')?.value === 'Career Inquiry';
    if (career) {
      gtag('event', 'career_phone_click', { event_category: 'recruiting' });
      return;
    }
    var phone = link.getAttribute('href').replace('tel:', '');
    gtag('event', 'phone_call_click', { event_category: 'engagement', phone_number: phone });
    if (window.__wplInternal) return;
    if (adsPhoneSendTo) gtag('event', 'conversion', { send_to: adsPhoneSendTo, value: 25, currency: 'USD' });
    if (window.uetq) window.uetq.push('event', 'contact', { event_category: 'phone_click', event_label: phone, event_value: 25 });
    var eventId = window.crypto && typeof window.crypto.randomUUID === 'function'
      ? window.crypto.randomUUID() : 'call-' + Date.now() + '-' + Math.random().toString(36).slice(2);
    fbq('track', 'Contact', {}, { eventID: eventId });
    try {
      fetch('/api/track-call/', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true,
        body: JSON.stringify({ event_id: eventId, url: window.location.href, fbp: __wplReadCookie('_fbp'), fbc: __wplReadCookie('_fbc') }),
      }).catch(function () { /* Supplementary analytics must not interrupt navigation. */ });
    } catch (_) { /* Supplementary analytics only. */ }
  });
</script>
