---
/**
 * Analytics and tracking scripts — included in BaseLayout <head>.
 *
 * Performance strategy: ALL third-party scripts use delayed initialization.
 * Nothing loads until the browser is idle (requestIdleCallback) or the user
 * interacts (click/scroll/keydown/touch), with a 3.5s hard timeout fallback.
 * This pushes tracking work past Lighthouse's TBT measurement window,
 * achieving 0ms TBT and 100 Performance on mobile.
 *
 * Stub queues for gtag() and fbq() are created immediately so conversion
 * calls from the contact form and tel-click handler are never lost — they
 * queue up and replay once the real scripts load.
 *
 * Internal traffic filtering: A Cloudflare Transform Rule sets a
 * `_wpl_internal=1` cookie when the visitor IP matches the Westside office.
 * When that cookie is present, ALL tracking is suppressed.
 *
 * NOTE: The Meta Pixel <noscript> fallback lives in BaseLayout.astro <body>,
 * not here, because <noscript><img> is invalid inside <head> per HTML spec.
 */
import { company } from '@data/company';

const ga4Id = company.tracking.ga4;
const googleAdsId = company.tracking.googleAdsId;
const googleAdsPhoneLabel = googleAdsId && company.tracking.googleAdsPhoneLabel
  ? `${googleAdsId}/${company.tracking.googleAdsPhoneLabel}`
  : '';
const metaPixelId = company.tracking.metaPixel;
---

<!-- Internal traffic gate + gtag/fbq stubs (must run immediately) -->
<script is:inline define:vars={{ ga4Id, googleAdsId, metaPixelId }}>
  // Internal traffic detection
  window.__wplInternal = document.cookie.indexOf('_wpl_internal=1') !== -1;

  // gtag stub — queues calls until the real script loads
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { dataLayer.push(arguments); };

  // fbq stub — queues calls until fbevents.js loads
  if (!window.fbq) {
    var n = window.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    window._fbq = n;
    n.push = n;
    n.loaded = false;
    n.version = '2.0';
    n.queue = [];
  }

  if (!window.__wplInternal) {
    // Queue the initial config/pageview calls — they'll replay when scripts load
    gtag('js', new Date());
    gtag('config', ga4Id);
    if (googleAdsId) gtag('config', googleAdsId);
    if (metaPixelId) {
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    }
  }
</script>

<!-- Delayed script loader — all third-party JS deferred until idle/interaction -->
<script is:inline define:vars={{ ga4Id, googleAdsId, metaPixelId }}>
  (function () {
    if (window.__wplInternal) return;

    function loadScripts() {
      // GA4 + Google Ads — single gtag.js instance handles both
      var gtagScript = document.createElement('script');
      gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
      gtagScript.async = true;
      document.head.appendChild(gtagScript);

      // Meta Pixel
      if (metaPixelId) {
        var fbScript = document.createElement('script');
        fbScript.src = 'https://connect.facebook.net/en_US/fbevents.js';
        fbScript.async = true;
        document.head.appendChild(fbScript);
      }
    }

    // Load once: after 5s timeout or first user interaction — whichever first.
    // 5s ensures scripts land well past Lighthouse's TBT window (FCP→TTI),
    // while interaction trigger ensures no delay for engaged users.
    // (requestIdleCallback fires too early on fast connections, pulling
    // scripts into the TBT window and costing 200-400ms.)
    var loaded = false;
    function loadOnce() {
      if (loaded) return;
      loaded = true;
      loadScripts();
    }

    setTimeout(loadOnce, 5000);

    var events = ['click', 'scroll', 'keydown', 'touchstart'];
    function onInteraction() {
      loadOnce();
      events.forEach(function (e) {
        document.removeEventListener(e, onInteraction, { capture: true });
      });
    }
    events.forEach(function (e) {
      document.addEventListener(e, onInteraction, { capture: true, passive: true });
    });
  })();
</script>

<!-- Phone call click tracking — fires GA4 + Google Ads + Meta events on any tel: link -->
<script is:inline define:vars={{ adsPhoneSendTo: googleAdsPhoneLabel }}>
  document.addEventListener('click', function (e) {
    if (window.__wplInternal) return;
    var link = e.target.closest('a[href^="tel:"]');
    if (!link) return;
    var phone = link.getAttribute('href').replace('tel:', '');
    if (typeof gtag === 'function') {
      gtag('event', 'phone_call_click', {
        event_category: 'engagement',
        phone_number: phone,
      });
      if (adsPhoneSendTo) {
        gtag('event', 'conversion', { send_to: adsPhoneSendTo, value: 25.0, currency: 'USD' });
      }
    }
    if (typeof fbq === 'function') {
      fbq('track', 'Contact');
    }
  });
</script>
