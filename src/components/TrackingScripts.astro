---
/**
 * Analytics and tracking scripts — included in BaseLayout <head>.
 *
 * Loading strategy: gtag.js and fbevents.js load IMMEDIATELY via async
 * <script> injection. This ensures:
 *   1. Google's Ads tag detector sees the tag on its first crawl (a 5s delay
 *      was invisible to non-JS and short-timeout crawlers → PMax and smart
 *      bidding got flagged as "Missing Google tag" and throttled serving).
 *   2. Fast bouncers (under 1-2s dwell, no interaction) still fire page_view
 *      and conversion events.
 *
 * Stub queues for gtag() and fbq() are created immediately so any conversion
 * calls from the contact form or tel-click handler that fire before the real
 * scripts finish downloading are never lost — they queue and replay.
 *
 * Perf tradeoff: async scripts don't block render but do add parse work.
 * Typical impact: Lighthouse mobile Performance ~92-96 (vs. 100 with delay).
 * That's an acceptable cost when the alternative is ad campaigns stuck at
 * zero impressions due to missing tag detection.
 *
 * Internal traffic filtering (two layers):
 *   1. Cloudflare Transform Rule sets `_wpl_internal=1` cookie for known
 *      internal IPs (Westside office + Joshua home). Meta Pixel and Google
 *      Ads tracking are completely blocked when this cookie is present.
 *   2. GA4 events still fire for internal traffic, but are tagged with
 *      `traffic_type=internal`. A GA4 Data Filter (configured in the GA4
 *      admin UI) excludes these from reports. This second layer catches
 *      any internal traffic that slips past the cookie (new IPs, cleared
 *      cookies, etc.) and allows viewing internal vs. external separately.
 *
 * NOTE: The Meta Pixel <noscript> fallback lives in BaseLayout.astro <body>,
 * not here, because <noscript><img> is invalid inside <head> per HTML spec.
 */
import { company } from '@data/company';

const ga4Id = company.tracking.ga4;
const googleAdsId = company.tracking.googleAdsId;
const googleAdsPhoneLabel = googleAdsId && company.tracking.googleAdsPhoneLabel
  ? `${googleAdsId}/${company.tracking.googleAdsPhoneLabel}`
  : '';
const microsoftUetId = company.tracking.microsoftUet;
const metaPixelId = company.tracking.metaPixel;
---

<!-- Acquisition attribution capture.
     Must run BEFORE any form script reads it, and must persist: a visitor
     usually lands on an ad destination page with ?utm_source=... or ?gclid=...,
     browses to /contact/, and submits from a URL with no parameters at all. We
     capture on first pageview, keep the FIRST-touch values in sessionStorage,
     and expose them to the form and the server notification. Nothing here is a
     secret — these are the same values already visible in the address bar. -->
<script is:inline>
  (function () {
    var KEY = '__wpl_attribution';
    var FIELDS = [
      'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
      'fbclid', 'gclid', 'msclkid',
    ];

    function read() {
      try {
        var raw = sessionStorage.getItem(KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (_) { return null; }
    }

    var stored = read();
    var params = new URLSearchParams(window.location.search);
    var incoming = {};
    var sawAny = false;
    FIELDS.forEach(function (f) {
      var v = params.get(f);
      if (v) { incoming[f] = v.slice(0, 200); sawAny = true; }
    });

    // First touch wins — a later untagged pageview must not erase the campaign
    // that actually produced the visit.
    if (sawAny && !stored) {
      incoming.landing_page = window.location.pathname + window.location.search;
      incoming.referrer = document.referrer ? document.referrer.slice(0, 300) : '';
      try { sessionStorage.setItem(KEY, JSON.stringify(incoming)); } catch (_) { /* private mode */ }
      stored = incoming;
    } else if (!stored) {
      // No campaign parameters anywhere — still record where they came from.
      stored = {
        landing_page: window.location.pathname + window.location.search,
        referrer: document.referrer ? document.referrer.slice(0, 300) : '',
      };
      try { sessionStorage.setItem(KEY, JSON.stringify(stored)); } catch (_) { /* private mode */ }
    }

    window.__wplAttribution = function () { return read() || stored || {}; };
  })();
</script>

<!-- Internal traffic gate + gtag/fbq stubs (must run immediately) -->
<script is:inline define:vars={{ ga4Id, googleAdsId, metaPixelId }}>
  // Internal traffic detection
  window.__wplInternal = document.cookie.indexOf('_wpl_internal=1') !== -1;

  // gtag stub — queues calls until the real script loads
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { dataLayer.push(arguments); };

  // fbq stub — queues calls until fbevents.js loads
  if (!window.fbq) {
    var n = window.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    window._fbq = n;
    n.push = n;
    n.loaded = false;
    n.version = '2.0';
    n.queue = [];
  }

  // GA4 always initializes — internal traffic tagged for GA4 data filter
  if (window.__wplInternal) gtag('set', { 'traffic_type': 'internal' });
  gtag('js', new Date());
  gtag('config', ga4Id);

  // Google Ads + Meta Pixel: completely blocked for internal traffic
  if (!window.__wplInternal) {
    if (googleAdsId) gtag('config', googleAdsId);
    if (metaPixelId) {
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    }
  }
</script>

<!-- Immediate async script loader — gtag.js, fbevents.js, and Microsoft UET load right away.
     Async means no render blocking. Firing immediately means ad-platform tag
     detectors see the tags on first crawl, and fast bouncers still register
     conversion events. -->
<script is:inline define:vars={{ ga4Id, metaPixelId, microsoftUetId }}>
  (function () {
    // GA4 — always loaded (internal traffic filtered via GA4 data filter).
    // Script URL carries the GA4 ID; Google Ads config runs from the inline
    // stub above and is picked up by gtag.js via dataLayer replay.
    var gtagScript = document.createElement('script');
    gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    gtagScript.async = true;
    document.head.appendChild(gtagScript);

    // Ad-platform tags are blocked for internal traffic.
    if (metaPixelId && !window.__wplInternal) {
      var fbScript = document.createElement('script');
      fbScript.src = 'https://connect.facebook.net/en_US/fbevents.js';
      fbScript.async = true;
      document.head.appendChild(fbScript);
    }

    if (microsoftUetId && !window.__wplInternal) {
      window.uetq = window.uetq || [];
      var uetScript = document.createElement('script');
      uetScript.src = 'https://bat.bing.com/bat.js';
      uetScript.async = true;
      uetScript.onload = uetScript.onreadystatechange = function () {
        var state = this.readyState;
        if (state && state !== 'loaded' && state !== 'complete') return;
        var options = { ti: microsoftUetId, enableAutoSpaTracking: true };
        options.q = window.uetq;
        window.uetq = new window.UET(options);
        window.uetq.push('pageLoad');
        uetScript.onload = uetScript.onreadystatechange = null;
      };
      document.head.appendChild(uetScript);
    }
  })();
</script>

<!-- Phone call click tracking — fires GA4 + Google Ads + Meta events on any tel: link.
     Meta Contact event is mirrored server-side via /api/track-call/ for CAPI dedup
     (browser pixel + server event share an event_id so Meta counts them as one). -->
<script is:inline define:vars={{ adsPhoneSendTo: googleAdsPhoneLabel }}>
  function __wplReadCookie(name) {
    var parts = document.cookie ? document.cookie.split(';') : [];
    for (var i = 0; i < parts.length; i++) {
      var kv = parts[i].trim().split('=');
      if (kv[0] === name) return decodeURIComponent(kv.slice(1).join('=')) || '';
    }
    return '';
  }

  document.addEventListener('click', function (e) {
    var link = e.target.closest('a[href^="tel:"]');
    if (!link) return;
    var phone = link.getAttribute('href').replace('tel:', '');
    // GA4 event always fires (internal traffic filtered via data filter)
    if (typeof gtag === 'function') {
      gtag('event', 'phone_call_click', {
        event_category: 'engagement',
        phone_number: phone,
      });
      // Google Ads conversion — blocked for internal traffic.
      if (adsPhoneSendTo && !window.__wplInternal) {
        gtag('event', 'conversion', { send_to: adsPhoneSendTo, value: 25.0, currency: 'USD' });
      }
      // Microsoft Ads phone-click signal. Keep it separate from the primary
      // estimate-submit event: a tap is useful intent, but not proof a call connected.
      if (window.uetq && !window.__wplInternal) {
        window.uetq.push('event', 'contact', {
          event_category: 'phone_click',
          event_label: phone,
          event_value: 25,
        });
      }
    }
    // Meta event — blocked for internal traffic
    if (!window.__wplInternal) {
      // Shared event_id used by both the browser pixel and the server CAPI call
      var eventId = (window.crypto && typeof window.crypto.randomUUID === 'function')
        ? window.crypto.randomUUID()
        : 'call-' + Date.now() + '-' + Math.random().toString(36).slice(2);

      if (typeof fbq === 'function') {
        fbq('track', 'Contact', {}, { eventID: eventId });
      }

      // Mirror server-side via CAPI; keepalive ensures the request survives the
      // tel: navigation that's about to interrupt the page.
      try {
        fetch('/api/track-call/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify({
            event_id: eventId,
            url: window.location.href,
            fbp: __wplReadCookie('_fbp'),
            fbc: __wplReadCookie('_fbc'),
          }),
        }).catch(function () { /* swallow — CAPI is supplementary */ });
      } catch (_) { /* ignore */ }
    }
  });
</script>
