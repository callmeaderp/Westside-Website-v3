---
/**
 * Base HTML layout — wraps every page.
 * Provides: <html>, <head> (via BaseHead), <body>, Header, Footer, scroll animations.
 */
import '@styles/global.css';
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { company } from '@data/company';

import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** ImageMetadata (from getPhoto) or a URL string for the OG image */
  ogImage?: ImageMetadata | string;
  ogType?: string;
  noindex?: boolean;
  /** Extra JSON-LD to inject in <head> */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogImage, ogType, noindex, jsonLd } = Astro.props;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Add .js class synchronously before any paint — CSS uses .js to hide
         fade-in content until IntersectionObserver reveals it. Without this
         in <head>, content flashes visible → hidden → animated back in. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    {jsonLdArray.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" style="margin-top: calc(-1 * var(--header-height));">
      <slot />
    </main>
    <Footer />

    <!-- Meta Pixel noscript fallback — must be in <body>, not <head>
         (HTML spec: noscript in head may only contain link/style/meta) -->
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${company.tracking.metaPixel}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>

    <!-- Scroll animation observer -->
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const animated = document.querySelectorAll('.fade-in, .fade-in-left, .fade-in-right, .stagger-children');
        if (animated.length > 0) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -20px 0px' }
          );
          animated.forEach((el) => observer.observe(el));

          // Catch elements already in viewport on load
          requestAnimationFrame(() => {
            animated.forEach((el) => {
              if (!el.classList.contains('visible')) {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight && rect.bottom > 0) {
                  el.classList.add('visible');
                  observer.unobserve(el);
                }
              }
            });
          });
        }

        // Scroll cue: show after paint, fade out on scroll
        const scrollCue = document.querySelector('.scroll-cue') as HTMLElement;
        if (scrollCue) {
          requestAnimationFrame(() => scrollCue.classList.add('is-visible'));
          window.addEventListener('scroll', () => {
            if (window.scrollY > 100) {
              scrollCue.classList.add('is-hidden');
              scrollCue.classList.remove('is-visible');
            } else {
              scrollCue.classList.remove('is-hidden');
              scrollCue.classList.add('is-visible');
            }
          }, { passive: true });
        }

        // Hero parallax — desktop only (mobile address bar animation
        // causes viewport resize that compounds jitter with per-frame transforms)
        const enableParallax = window.matchMedia('(min-width: 1024px)').matches;
        const heroBgs = document.querySelectorAll('.hero-bg');
        if (enableParallax && heroBgs.length > 0) {
          let ticking = false;
          window.addEventListener(
            'scroll',
            () => {
              if (!ticking) {
                ticking = true;
                requestAnimationFrame(() => {
                  heroBgs.forEach((bg) => {
                    const rect = bg.parentElement!.getBoundingClientRect();
                    if (rect.bottom > 0 && rect.top < window.innerHeight) {
                      (bg as HTMLElement).style.transform = `translateY(${-rect.top * 0.3}px)`;
                    }
                  });
                  ticking = false;
                });
              }
            },
            { passive: true }
          );
        }
      }
    </script>
  </body>
</html>
