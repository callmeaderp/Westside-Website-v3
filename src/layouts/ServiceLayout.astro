---
/**
 * Shared layout for individual service pages.
 * Wraps BaseLayout with service-specific hero, breadcrumbs, and CTA.
 */
import BaseLayout from './BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { company } from '@data/company';
import type { Service } from '@data/services';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';

interface Props {
  service: Service;
  ctaHeading?: string;
  ctaText?: string;
}

const { service, ctaHeading, ctaText } = Astro.props;

// Build structured data for this service
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: service.name,
      description: service.description,
      provider: {
        '@type': 'LandscapingBusiness',
        name: company.name,
        url: company.url,
        telephone: company.phoneTel,
        address: {
          '@type': 'PostalAddress',
          streetAddress: company.address.street,
          addressLocality: company.address.city,
          addressRegion: company.address.state,
          postalCode: company.address.zip,
          addressCountry: company.address.country,
        },
      },
      areaServed: {
        '@type': 'City',
        name: 'Rochester',
        containedInPlace: { '@type': 'State', name: 'New York' },
      },
      url: siteUrl(`/services/${service.slug}`),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Services', item: siteUrl('/services') },
        {
          '@type': 'ListItem',
          position: 3,
          name: service.shortName,
          item: siteUrl(`/services/${service.slug}`),
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={getPhoto(service.heroImage)}
  jsonLd={serviceJsonLd}
>
  <Hero
    label={service.heroLabel}
    heading={service.heroHeading}
    intro={service.heroIntro}
    image={getPhoto(service.heroImage)}
  />

  <!-- Service body content (unique per page) -->
  <slot />

  <CtaBanner heading={ctaHeading} text={ctaText} />
</BaseLayout>
