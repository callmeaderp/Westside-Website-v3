---
import BaseLayout from './BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { company } from '@data/company';
import type { Service } from '@data/services';
import type { FaqItem } from '@data/service-content';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';

interface Props {
  service: Service;
  ctaHeading?: string;
  ctaText?: string;
  faqs?: FaqItem[];
  /** Hero call-to-action buttons. Without these the hero is a dead end. */
  heroButtons?: Array<{ text: string; href: string; style: 'primary' | 'dark' | 'outline' }>;
}

const { service, ctaHeading, ctaText, faqs, heroButtons } = Astro.props;

const schemaGraph: Record<string, unknown>[] = [
  {
    '@type': 'Service',
    name: service.name,
    description: service.description,
    provider: {
      '@type': 'HomeAndConstructionBusiness',
      name: company.name,
      url: company.url,
      telephone: company.phoneTel,
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.address.street,
        addressLocality: company.address.city,
        addressRegion: company.address.state,
        postalCode: company.address.zip,
        addressCountry: company.address.country,
      },
    },
    areaServed: company.areasServed.map((city) => ({
      '@type': 'City',
      name: city,
      ...(city === 'Rochester' ? { containedInPlace: { '@type': 'State', name: 'New York' } } : {}),
    })),
    url: siteUrl(`/services/${service.slug}`),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Services', item: siteUrl('/services') },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.name,
        item: siteUrl(`/services/${service.slug}`),
      },
    ],
  },
];

// Add FAQPage schema when FAQs are provided (enables FAQ rich snippets)
if (faqs && faqs.length > 0) {
  schemaGraph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}

const serviceJsonLd = { '@context': 'https://schema.org', '@graph': schemaGraph };
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  ogImage={getPhoto(service.heroImage)}
  jsonLd={serviceJsonLd}
>
  <Hero
    label={service.heroLabel}
    heading={service.heroHeading}
    intro={service.heroIntro}
    image={getPhoto(service.heroImage)}
    buttons={heroButtons ?? [
      { text: service.cta, href: `/contact/?service=${service.slug}`, style: 'primary' },
      { text: `Call ${company.phone}`, href: company.phoneHref, style: 'outline' },
    ]}
  />

  <slot />

  <CtaBanner heading={ctaHeading} text={ctaText} />
</BaseLayout>
