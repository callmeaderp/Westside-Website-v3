---
/**
 * About page — company story, timeline, certifications, team.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'About', item: siteUrl('/about') },
  ],
};
---

<BaseLayout
  title="About Westside Professional Landscape | Rochester NY Since 2000"
  description="Learn about Westside Professional Landscape — serving Rochester NY since 2000. Full-service landscaping, certified applicators, locally owned and operated."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Our Story"
    heading="ROCHESTER'S TRUSTED LANDSCAPING COMPANY SINCE 2000"
    intro="From a small Rochester startup to a full-service design-build landscape company, our journey is defined by quality, integrity, and a passion for the outdoors."
    image={getPhoto('hero-about.webp')}
  />

  <!-- Company Story -->
  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="max-w-3xl mx-auto fade-in">
        <p class="section-label">Our Journey</p>
        <h2 class="section-title">BUILT ON QUALITY & <span class="text-green">INTEGRITY</span></h2>
        <p class="mb-6" style="color: var(--color-text-muted); line-height: 1.8;">
          <strong>Founded in 2000</strong>, <strong>Westside Professional Landscape</strong> has grown from a small operation into a
          full-service design-build landscape company. Our success is rooted in a simple philosophy: do exceptional
          work, treat every property like our own, and build <em>lasting relationships</em> with our clients.
        </p>
        <p style="color: var(--color-text-muted); line-height: 1.8;">
          Today, we serve residential and commercial properties across <strong>Greater Rochester</strong>, offering everything
          from landscape design and installation to <em>year-round</em> maintenance, hardscaping, and snow management.
        </p>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-24 section-white">
    <div class="site-container text-center">
      <p class="section-label">Credentials</p>
      <h2 class="section-title">CERTIFIED & <span class="text-green">TRUSTED</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12 stagger-children">
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">NYS DEC Certified</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            Our plant health technicians hold <strong>New York State DEC Commercial Pesticide Applicator</strong> credentials — meaning your lawn treatments are applied safely, legally, and effectively.
          </p>
        </div>
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">SYNLawn Authorized Dealer</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            As an <strong>Authorized SYNLawn dealer</strong>, we install premium artificial turf backed by manufacturer warranties — a low-maintenance, year-round green alternative for residential and commercial properties.
          </p>
        </div>
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">Locally Owned Since 2000</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            Over <strong>two decades</strong> of steady growth built on quality work, word-of-mouth referrals, and lasting client relationships across the Greater Rochester area.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-24 section-dark">
    <div class="site-container">
      <div class="max-w-3xl mx-auto text-center fade-in">
        <p class="section-label">Our People</p>
        <h2 class="section-title">A TEAM THAT <span class="text-green">CARES</span></h2>
        <p class="text-sm mt-6" style="color: var(--color-text-muted); line-height: 1.8;">
          Behind every project is a dedicated team of landscape professionals who take pride in their work.
          From our certified applicators to our experienced crew leaders, everyone at Westside shares a
          commitment to <strong style="color: var(--color-text-light);">quality, reliability, and treating every property like our own</strong>.
        </p>
        <p class="text-sm mt-4" style="color: var(--color-text-muted); line-height: 1.8;">
          We're a locally owned company — and you'll notice the difference in every interaction.
        </p>
        <a href={url('/contact')} class="btn btn-primary btn-md mt-8">Get in Touch</a>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
