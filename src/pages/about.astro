---
/**
 * About page — company story, timeline, certifications, team.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'About', item: siteUrl('/about') },
  ],
};
---

<BaseLayout
  title="About Westside Professional Landscape | Rochester NY Since 2000"
  description="Meet Westside Professional Landscape, a locally owned, full-service Rochester landscaping company serving the area since 2000."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Our Story"
    heading="ROCHESTER'S TRUSTED LANDSCAPING COMPANY SINCE 2000"
    intro="We started small in Rochester in 2000. Today, one local team designs, builds, and cares for properties across the area."
    image={getPhoto('hero-about.webp')}
  />

  <!-- Company Story -->
  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="max-w-3xl mx-auto fade-in">
        <p class="section-label">How We Got Here</p>
        <h2 class="section-title">SOLID WORK, BUILT TO <span class="text-green">LAST</span></h2>
        <p class="mb-6" style="color: var(--color-text-muted); line-height: 1.8;">
          <strong>Westside Professional Landscape</strong> began as a small local operation in <strong>2000</strong>. We grew by doing dependable work, respecting each property, and earning the next call from the people we served.
        </p>
        <p style="color: var(--color-text-muted); line-height: 1.8;">
          Today, we serve residential and commercial properties across <strong>Greater Rochester</strong>, offering everything
          from landscape design and installation to <em>year-round</em> maintenance, hardscaping, and snow management.
        </p>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-24 section-white">
    <div class="site-container text-center">
      <p class="section-label">Credentials</p>
      <h2 class="section-title">THE CREDENTIALS BEHIND THE <span class="text-green">WORK</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12 stagger-children">
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">NYS DEC Certified</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            Our plant health technicians hold <strong>New York State DEC Commercial Pesticide Applicator</strong> credentials. They apply lawn treatments at labeled rates and follow New York requirements.
          </p>
        </div>
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">SYNLawn Authorized Dealer</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            As an <strong>Authorized SYNLawn dealer</strong>, we install manufacturer-backed artificial turf for homes and commercial properties that need a dependable green surface with less upkeep.
          </p>
        </div>
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">Locally Owned Since 2000</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            More than <strong>two decades</strong> of local work, repeat clients, and word-of-mouth referrals across Greater Rochester.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-24 section-dark">
    <div class="site-container">
      <div class="max-w-3xl mx-auto text-center fade-in">
        <p class="section-label">Our People</p>
        <h2 class="section-title">A TEAM THAT <span class="text-green">CARES</span></h2>
        <p class="text-sm mt-6" style="color: var(--color-text-muted); line-height: 1.8;">
          From certified applicators to crew leaders, the people at Westside know their work and care how the finished property looks. We show up prepared, do the job properly, and respect your home or business.
        </p>
        <p class="text-sm mt-4" style="color: var(--color-text-muted); line-height: 1.8;">
          We're locally owned, so the people you talk to are close to the work.
        </p>
        <a href={url('/contact')} class="btn btn-primary btn-md mt-8">Get in Touch</a>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
