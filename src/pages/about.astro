---
/**
 * About page — company story, timeline, certifications, team.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { company } from '@data/company';
import { team } from '@data/team';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${company.url}/` },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${company.url}/about` },
  ],
};
---

<BaseLayout
  title="About Westside Professional Landscape | Rochester NY Since 2000"
  description="Learn about Westside Professional Landscape — serving Rochester NY since 2000. Full-service landscaping, certified applicators, Top 100 company."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Our Story"
    heading="ROCHESTER'S TRUSTED LANDSCAPING COMPANY SINCE 2000"
    intro="From a small Rochester startup to one of the region's most trusted landscape companies, our journey is defined by quality, integrity, and a passion for the outdoors."
    image={url('/images/photos/hero-about.webp')}
  />

  <!-- Company Story -->
  <section class="py-24 section-dark-alt">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="fade-in-left">
          <p class="section-label">Our Journey</p>
          <h2 class="section-title">BUILT ON QUALITY & INTEGRITY</h2>
          <p class="mb-6" style="color: var(--color-text-muted); line-height: 1.8;">
            Founded in 2000, Westside Professional Landscape has grown from a small operation into one of Rochester's
            most trusted full-service landscape companies. Our success is rooted in a simple philosophy: do exceptional
            work, treat every property like our own, and build lasting relationships with our clients.
          </p>
          <p class="mb-6" style="color: var(--color-text-muted); line-height: 1.8;">
            Today, we serve hundreds of residential and commercial properties across Greater Rochester, offering everything
            from landscape design and installation to year-round maintenance, hardscaping, and snow management.
          </p>
        </div>
        <div class="fade-in-right">
          <img
            src={url('/images/photos/about-company.webp')}
            alt="Westside Professional Landscape projects"
            class="rounded-xl shadow-lg"
            loading="lazy"
            width="600"
            height="400"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-24 section-white">
    <div class="container text-center">
      <p class="section-label">Credentials</p>
      <h2 class="section-title">CERTIFIED & TRUSTED</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12 stagger-children">
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">NYS DEC Certified</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            All plant health technicians are New York State DEC Certified Commercial Pesticide Applicators.
          </p>
        </div>
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">SYNLawn Dealer</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            Authorized SYNLawn dealer — premium artificial turf installation for residential and commercial properties.
          </p>
        </div>
        <div class="p-8 rounded-xl bg-bg-light border border-border-light">
          <h3 class="text-lg mb-3">Top 100 Company</h3>
          <p class="text-sm" style="color: var(--color-text-body-dark);">
            Recognized as a Top 100 landscape company — a testament to our commitment to excellence and growth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-24 section-dark">
    <div class="container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Leadership</p>
        <h2 class="section-title">MEET THE TEAM</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger-children">
        {team.map((member) => (
          <div class="text-center">
            <div class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden" style="border: 3px solid var(--color-green-bright);">
              <img
                src={url(`/images/photos/${member.image}`)}
                alt={member.name}
                class="w-full h-full object-cover"
                loading="lazy"
                width="128"
                height="128"
              />
            </div>
            <h3 class="text-base mb-1">{member.name}</h3>
            <p class="text-sm" style="color: var(--color-green-bright);">{member.role}</p>
            <p class="text-xs mt-2" style="color: var(--color-text-muted);">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
