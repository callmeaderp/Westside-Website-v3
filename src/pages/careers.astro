---
/**
 * Careers page — general interest CTA (no specific listings).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import { company } from '@data/company';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Careers', item: siteUrl('/careers') },
  ],
};
---

<BaseLayout
  title="Careers at Westside Professional Landscape | Rochester, NY"
  description="Interested in a career in landscaping? Westside Professional Landscape is always looking for hardworking, passionate people to join our team in Rochester, NY."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Join Our Team"
    heading="BUILD YOUR CAREER IN LANDSCAPING"
    intro="We're a locally owned landscape company that's been growing since 2000 — and we're always looking for good people."
    image={getPhoto('hero-about.webp')}
  />

  <!-- Why Westside -->
  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Why Westside</p>
        <h2 class="section-title">MORE THAN JUST A <span class="text-green">JOB</span></h2>
        <p class="section-subtitle mx-auto">
          At <strong>Westside</strong>, you're not just an employee — you're part of a team that takes pride in every project.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {[
          { title: 'Competitive Pay', desc: '<strong>Competitive wages</strong> based on your experience and role.' },
          { title: 'Year-Round Work', desc: 'Landscaping in spring, summer, and fall. Snow management in winter — <strong>steady employment</strong>.' },
          { title: 'Growth Opportunities', desc: 'Room to advance as you build your skills and take on more responsibility.' },
          { title: 'Invest in Your Skills', desc: 'We support professional development and help team members build their expertise.' },
          { title: 'Team Culture', desc: 'A supportive, respectful workplace where <em>your work matters</em> and your voice is heard.' },
          { title: 'Quality Equipment', desc: 'Professional-grade equipment maintained to high standards. We provide what you need to do the job right.' },
        ].map((benefit) => (
          <div class="p-8 rounded-xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
            <h3 class="text-base mb-3">{benefit.title}</h3>
            <p class="text-sm" style="color: var(--color-text-muted);" set:html={benefit.desc} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- General Interest -->
  <section class="py-24 section-white">
    <div class="site-container">
      <div class="max-w-2xl mx-auto text-center fade-in">
        <p class="section-label">Opportunities</p>
        <h2 class="section-title">THINK YOU'RE <span class="text-green">WESTSIDE MATERIAL?</span></h2>
        <p class="mt-6 mb-4" style="color: var(--color-text-body-dark); line-height: 1.8;">
          Whether you're an experienced landscaper, a certified applicator, or someone who's eager to
          learn and work hard outdoors — we'd like to hear from you.
        </p>
        <p class="mb-8" style="color: var(--color-text-body-dark); line-height: 1.8;">
          Send us your resume and a few words about yourself. We'll reach out if there's a fit.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={url('/contact/?service=careers')} class="btn btn-primary btn-lg">Send Us Your Resume</a>
          <a href={`tel:${company.phoneTel}`} class="btn btn-outline btn-md">
            Or Call {company.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
