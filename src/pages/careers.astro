---
/**
 * Careers page — job listings, culture, application CTA.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { company } from '@data/company';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${company.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Careers', item: `${company.url}/careers` },
  ],
};
---

<BaseLayout
  title="Landscaping Jobs & Careers | Rochester, NY | Westside Professional Landscape"
  description="Join the Westside Professional Landscape team. Now hiring landscapers, lawn care technicians, and crew leaders in Rochester NY. Competitive pay, growth opportunities, year-round work."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Join Our Team"
    heading="BUILD YOUR CAREER IN LANDSCAPING"
    intro="We're always looking for hardworking, passionate people to join the Westside family. Competitive pay, room to grow, and the satisfaction of transforming outdoor spaces every day."
    image={url('/images/photos/hero-about.webp')}
  />

  <!-- Why Westside -->
  <section class="py-24 section-dark-alt">
    <div class="container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Why Westside</p>
        <h2 class="section-title">MORE THAN JUST A <span class="text-green">JOB</span></h2>
        <p class="section-subtitle mx-auto">
          At Westside, you're not just an employee — you're part of a team that takes pride in every project.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {[
          { title: 'Competitive Pay', desc: 'Above-market wages with performance bonuses and overtime opportunities.' },
          { title: 'Year-Round Work', desc: 'Landscaping in spring/summer/fall, snow management in winter — steady employment.' },
          { title: 'Growth Opportunities', desc: 'Clear advancement paths from crew member to crew leader to management.' },
          { title: 'Training & Certification', desc: 'We invest in your skills — paid training, certifications, and professional development.' },
          { title: 'Team Culture', desc: 'A supportive, respectful workplace where your work matters and your voice is heard.' },
          { title: 'Equipment & Tools', desc: 'Top-quality equipment maintained to professional standards. No bringing your own gear.' },
        ].map((benefit) => (
          <div class="p-8 rounded-xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
            <h3 class="text-base mb-3">{benefit.title}</h3>
            <p class="text-sm" style="color: var(--color-text-muted);">{benefit.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Open Positions -->
  <section class="py-24 section-white">
    <div class="container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Open Positions</p>
        <h2 class="section-title">CURRENT <span class="text-green">OPENINGS</span></h2>
      </div>

      <div class="max-w-3xl mx-auto flex flex-col gap-6 stagger-children">
        {[
          { title: 'Landscape Crew Member', type: 'Full-time', desc: 'Install and maintain residential and commercial landscapes. Experience preferred but will train motivated candidates.' },
          { title: 'Lawn Care Technician', type: 'Full-time / Seasonal', desc: 'Apply fertilizer and weed control treatments. Must obtain or hold NYS DEC pesticide applicator certification.' },
          { title: 'Crew Leader', type: 'Full-time', desc: 'Lead a crew of 3-5 in daily landscape operations. 3+ years experience required. Valid driver\'s license required.' },
        ].map((job) => (
          <div class="p-8 rounded-xl flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-bg-light border border-border-light">
            <div>
              <h3 class="text-base mb-1">{job.title}</h3>
              <p class="text-xs mb-2" style="color: var(--color-green-primary);">{job.type}</p>
              <p class="text-sm" style="color: var(--color-text-body-dark);">{job.desc}</p>
            </div>
            <a href={url('/contact')} class="btn btn-primary btn-sm shrink-0">Apply Now</a>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <p class="text-sm mb-4" style="color: var(--color-text-body-dark);">
          Don't see a position that fits? We're always interested in hearing from talented people.
        </p>
        <a href={url('/contact')} class="btn btn-outline btn-md">Send Us Your Resume</a>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="READY TO JOIN THE TEAM?"
    text="Apply today and start building your career with Rochester's most trusted landscape company."
  />
</BaseLayout>
