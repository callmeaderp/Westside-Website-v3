---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CareerForm from '@components/CareerForm.astro';
import { careerRoles, formatCareerPay, referralBonus } from '@data/careers';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Careers', item: siteUrl('/careers/') },
  ],
};
---

<BaseLayout
  title="Landscaping & Snow Jobs in Rochester, NY | Westside Careers"
  description="Explore Plant Health, landscape design and commercial snow opportunities at Westside in Rochester, NY. View pay, schedules and requirements, then apply."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Careers at Westside"
    heading="GOOD WORK STARTS WITH GOOD PEOPLE"
    intro="Healthy lawns, thoughtfully built landscapes and safer winter properties all depend on the people doing the work. Find your place at our locally owned Rochester company, growing since 2000."
    image={getPhoto('hero-about.webp')}
    buttons={[
      { text: 'Explore Openings', href: '#openings', style: 'primary' },
      { text: 'Apply Now', href: '#apply', style: 'outline' },
    ]}
  />

  <section id="openings" class="py-20 section-dark-alt scroll-mt-24" aria-labelledby="openings-heading">
    <div class="site-container">
      <div class="max-w-3xl mb-10">
        <p class="section-label">Current opportunities</p>
        <h2 id="openings-heading" class="section-title">FIND YOUR <span class="text-green">NEXT ROLE</span></h2>
        <p class="section-subtitle mt-5">Read the pay range, schedule and qualifications for each opening. Year-round positions and seasonal snow work have different schedules and benefit eligibility.</p>
      </div>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
        {careerRoles.map((role) => (
          <article class="p-7 rounded-xl flex flex-col" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
            <p class="text-xs uppercase tracking-wider font-semibold mb-3" style="color: var(--color-green-bright);">{role.category}</p>
            <h3 class="text-xl leading-snug" style="font-family: var(--font-body); text-transform: none;">{role.title}</h3>
            <p class="font-semibold mt-4">{formatCareerPay(role.pay)}</p>
            <p class="text-sm mt-1" style="color: var(--color-text-muted);">{role.employmentLabel}</p>
            <p class="text-sm leading-relaxed mt-5 mb-6" style="color: var(--color-text-muted);">{role.summary}</p>
            <a href={url(`/careers/${role.slug}/`)} class="btn btn-outline btn-sm mt-auto self-start" aria-label={`View ${role.title} details and apply`}>View Role &amp; Apply</a>
          </article>
        ))}
      </div>
      <div class="mt-8 p-7 rounded-xl max-w-3xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);" data-referral-bonus>
        <h3 class="text-lg mb-3" style="font-family: var(--font-body); text-transform: none;">Know someone who works here?</h3>
        <p class="leading-relaxed" style="color: var(--color-text-muted);">Ask them to refer you. {referralBonus.newHire} {referralBonus.referrer}</p>
      </div>
      <p class="text-sm mt-7" style="color: var(--color-text-muted);">We’re always looking for good people. Not sure which opening fits? Use the general-interest option below and tell us about your experience.</p>
    </div>
  </section>

  <section class="py-20 section-dark" aria-labelledby="working-here-heading">
    <div class="site-container">
      <p class="section-label">Working here</p>
      <h2 id="working-here-heading" class="section-title mb-10">LOCAL ROOTS. <span class="text-green">HANDS-ON WORK.</span></h2>
      <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-9">
        <div><h3 class="text-lg mb-3">A range of skills</h3><p class="leading-relaxed" style="color: var(--color-text-muted);">Our work includes Plant Health and lawn care, landscape design and construction, maintenance, and commercial snow and ice management.</p></div>
        <div><h3 class="text-lg mb-3">Room to grow</h3><p class="leading-relaxed" style="color: var(--color-text-muted);">We’re still growing, and we would rather promote from within. When a foreman spot opens, we look first to the people already on our crews.</p></div>
        <div><h3 class="text-lg mb-3">Know the terms</h3><p class="leading-relaxed" style="color: var(--color-text-muted);">Each listing explains its base pay and work schedule. Benefits depend on the role, service requirements and plan eligibility. The hiring team can walk you through the details.</p></div>
        <div><h3 class="text-lg mb-3">A straightforward start</h3><p class="leading-relaxed" style="color: var(--color-text-muted);">Apply with your name and a phone number or email. A résumé is welcome, not required. Tell us what you do well and when you are available.</p></div>
      </div>
    </div>
  </section>

  <CareerForm />
</BaseLayout>
