---
/**
 * Contact / Free Estimate page — form + FAQ + contact details.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import { company } from '@data/company';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${company.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${company.url}/contact` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I get a free estimate?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Fill out the form above, give us a call, or send an email. We'll schedule an on-site visit to assess your property and provide a detailed, no-obligation estimate within 1-2 business days.",
        },
      },
      {
        '@type': 'Question',
        name: 'What areas do you serve?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'We serve the entire Greater Rochester area including Pittsford, Webster, Penfield, Fairport, Brighton, Greece, Gates, Chili, Henrietta, Victor, and surrounding communities.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I sign up for the 5-Step Lawn Care Program mid-season?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Yes! While the best results come from starting in spring, we can customize a program based on where you are in the season. Contact us and we'll recommend the best approach for your lawn.",
        },
      },
      {
        '@type': 'Question',
        name: 'Do you offer commercial services?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Absolutely. We serve HOAs, commercial properties, office parks, and retail locations with comprehensive landscape maintenance, snow management, and seasonal services.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are your technicians certified?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. All of our plant health and lawn care technicians are NYS DEC Certified Pesticide Applicators. Our company is fully licensed and insured.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Free Landscaping Estimate | Rochester, NY | Westside Professional Landscape"
  description="Get a free estimate from Westside Professional Landscape. Contact us for landscaping, lawn care, hardscaping, and more in Rochester NY."
  jsonLd={jsonLd}
>
  <Hero
    label="Get in Touch"
    heading="REQUEST A FREE ESTIMATE IN ROCHESTER, NY"
    intro="Ready to transform your outdoor space? Get a free, no-obligation estimate from our team. We'd love to hear about your project."
    image="/images/photos/hero-contact.webp"
  />

  <section class="py-24 section-dark-alt">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <form id="contact-form" class="flex flex-col gap-6" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY" />
            <input type="hidden" name="subject" value="New Estimate Request — Westside Website" />
            <input type="hidden" name="from_name" value="Westside Website Contact Form" />
            <div class="hidden"><input type="checkbox" name="botcheck" /></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">First Name *</label>
                <input type="text" id="first-name" name="first_name" required
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Last Name *</label>
                <input type="text" id="last-name" name="last_name" required
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Email *</label>
                <input type="email" id="email" name="email" required
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Phone</label>
                <input type="tel" id="phone" name="phone"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Service Interest</label>
              <select id="service" name="service_interest"
                class="w-full px-4 py-3 rounded-lg text-white text-sm"
                style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
              >
                <option value="">Select a service...</option>
                <option>Landscape Design</option>
                <option>Landscape Maintenance</option>
                <option>Fertilization & Weed Control</option>
                <option>Hardscaping</option>
                <option>Water Features</option>
                <option>Snow & Ice Management</option>
                <option>Holiday Decorating</option>
                <option>Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Message *</label>
              <textarea id="message" name="message" rows="5" required
                class="w-full px-4 py-3 rounded-lg text-white text-sm resize-y"
                style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                placeholder="Tell us about your project..."
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg self-start">
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Sidebar -->
        <div>
          <div class="rounded-xl p-8 mb-8" style="background: var(--color-bg-accent-card); border: 1px solid var(--color-border-accent);">
            <h3 class="text-lg mb-6">Contact Information</h3>
            <div class="flex flex-col gap-5">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span class="text-sm" style="color: var(--color-text-light);">{company.address.street}<br />{company.address.city}, {company.address.state} {company.address.zip}</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.8.36 1.58.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.83.28 1.61.51 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href={company.phoneHref} class="text-sm hover:text-white" style="color: var(--color-text-light);">{company.phone}</a>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href={`mailto:${company.email}`} class="text-sm hover:text-white" style="color: var(--color-text-light);">{company.email}</a>
              </div>
            </div>
          </div>

          <div class="rounded-xl p-8" style="background: var(--color-bg-accent-card); border: 1px solid var(--color-border-accent);">
            <h3 class="text-lg mb-4">Office Hours</h3>
            <div class="flex flex-col gap-2 text-sm" style="color: var(--color-text-muted);">
              <div class="flex justify-between">
                <span>Monday - Friday</span>
                <span>8:30 AM - 4:00 PM</span>
              </div>
              <div class="flex justify-between">
                <span>Saturday - Sunday</span>
                <span>Closed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Contact form submission handler
  const form = document.getElementById('contact-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = btn.textContent;
      btn.textContent = 'Sending...';
      btn.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, { method: 'POST', body: formData });
        const result = await response.json();
        if (result.success) {
          if (typeof fbq === 'function') fbq('track', 'Lead');
          btn.textContent = '\u2713 Message Sent!';
          btn.style.background = 'var(--color-green-primary)';
          form.reset();
          setTimeout(() => {
            btn.textContent = originalText;
            btn.style.background = '';
            btn.disabled = false;
          }, 4000);
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch {
        btn.textContent = 'Error \u2014 Please Call Us';
        btn.style.background = '#c0392b';
        setTimeout(() => {
          btn.textContent = originalText;
          btn.style.background = '';
          btn.disabled = false;
        }, 4000);
      }
    });
  }
</script>
