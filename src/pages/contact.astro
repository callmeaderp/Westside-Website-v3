---
/**
 * Contact / Free Estimate page — form + FAQ + contact details.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import { company } from '@data/company';
import { budgetOptions, projectTypeOptions, timingOptions } from '@data/investment';
import { services } from '@data/services';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const adsFormSendTo = company.tracking.googleAdsId && company.tracking.googleAdsFormLabel
  ? `${company.tracking.googleAdsId}/${company.tracking.googleAdsFormLabel}`
  : '';

const turnstileSiteKey = company.tracking.turnstileSiteKey || '';

/**
 * Service dropdown options and the ?service=<slug> preselect map are both
 * derived from services.ts so a new service can never silently go missing from
 * the form — that was previously a hand-maintained list in two places.
 */
const serviceOptions = services.map((s) => ({ slug: s.slug, label: s.name }));
const serviceSlugMap = Object.fromEntries(serviceOptions.map((o) => [o.slug, o.label]));

/** Format 24h "HH:MM" to "H:MM AM/PM" */
function formatTime(t: string): string {
  const [h, m] = t.split(':').map(Number);
  const period = h >= 12 ? 'PM' : 'AM';
  return `${h > 12 ? h - 12 : h === 0 ? 12 : h}:${String(m).padStart(2, '0')} ${period}`;
}

/** FAQ items — single source for both the UI cards and FAQPage JSON-LD. */
const faqItems: { question: string; answer: string }[] = [
  {
    question: 'How do I get a free estimate?',
    answer: "Fill out the form above, give us a call, or send an email. We'll review the project details and contact you to arrange the next step. After a site visit, we'll prepare a written, no-obligation estimate.",
  },
  {
    question: 'Why do you ask for a budget range?',
    answer: "So we can design something you'll actually build. A patio can be a $9,000 project or a $45,000 project depending on size, walls, lighting, and materials — knowing your range up front means the first proposal lands somewhere realistic instead of wasting both our time. \"Not sure yet\" is a completely valid answer; we'll help you scope it on site.",
  },
  {
    question: 'What areas do you serve?',
    answer: 'We serve the entire Greater Rochester area including Pittsford, Webster, Penfield, Fairport, Brighton, Greece, Gates, Chili, Henrietta, Victor, and surrounding communities.',
  },
  {
    question: 'Do you offer financing on construction projects?',
    answer: 'Yes. We offer financing through Wells Fargo so a larger patio, wall, or full backyard project can be paid over time. Approval and terms are handled by Wells Fargo, not by us.',
  },
  {
    question: 'Do you offer commercial services?',
    answer: 'Absolutely. We serve HOAs, commercial properties, office parks, and retail locations with comprehensive landscape maintenance, snow management, and seasonal services.',
  },
  {
    question: 'Are your technicians certified?',
    answer: 'Yes. Our plant health technicians hold NYS DEC Certified Commercial Pesticide Applicator credentials, and our company is licensed and insured.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: siteUrl('/contact') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="Free Landscaping & Hardscape Estimate | Rochester, NY | Westside"
  description="Get a free estimate from Westside Professional Landscape. Patios, retaining walls, walkways, drainage, landscape design, lawn care, and more in Rochester NY."
  jsonLd={jsonLd}
>
  <Hero
    label="Get in Touch"
    heading="REQUEST A FREE ESTIMATE IN ROCHESTER, NY"
    intro="Tell us about your project and roughly what you'd like to spend. We'll walk the property and give you a written, itemized estimate — no obligation."
    image={getPhoto('hero-contact.webp')}
    buttons={[
      { text: `Call ${company.phone}`, href: company.phoneHref, style: 'primary' },
      { text: 'See Project Ranges', href: '/services/hardscaping/#investment', style: 'outline' },
    ]}
  />

  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <form
            id="contact-form"
            class="flex flex-col gap-6"
            data-ads-send-to={adsFormSendTo}
            data-service-map={JSON.stringify(serviceSlugMap)}
          >

            <p class="text-sm" style="color: var(--color-text-muted);">
              Fields marked <span style="color: var(--color-green-bright);">*</span> are required. Everything else just helps us prepare before we arrive.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">First Name <span style="color: var(--color-green-bright);">*</span></label>
                <input type="text" id="first-name" name="first_name" required autocomplete="given-name"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Last Name <span style="color: var(--color-green-bright);">*</span></label>
                <input type="text" id="last-name" name="last_name" required autocomplete="family-name"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Email <span style="color: var(--color-green-bright);">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" inputmode="email"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Phone <span style="color: var(--color-green-bright);">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                  placeholder="(585) 555-0123"
                />
              </div>
            </div>

            <fieldset class="border-0 p-0 m-0">
              <legend class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Best Way to Reach You</legend>
              <div class="flex flex-wrap gap-x-6 gap-y-2">
                <label class="flex items-center gap-2 text-sm cursor-pointer" style="color: var(--color-text-muted);">
                  <input type="radio" name="contact_preference" value="Phone call" checked class="accent-[#6CC551] w-4 h-4" />
                  Phone call
                </label>
                <label class="flex items-center gap-2 text-sm cursor-pointer" style="color: var(--color-text-muted);">
                  <input type="radio" name="contact_preference" value="Text message" class="accent-[#6CC551] w-4 h-4" />
                  Text message
                </label>
                <label class="flex items-center gap-2 text-sm cursor-pointer" style="color: var(--color-text-muted);">
                  <input type="radio" name="contact_preference" value="Email" class="accent-[#6CC551] w-4 h-4" />
                  Email
                </label>
              </div>
            </fieldset>

            <div class="grid grid-cols-1 md:grid-cols-[1fr_160px] gap-6">
              <div class="relative">
                <label for="address" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Property Address</label>
                <input type="text" id="address" name="address" autocomplete="off"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                  placeholder="Start typing your address..."
                  role="combobox"
                  aria-expanded="false"
                  aria-autocomplete="list"
                  aria-controls="address-suggestions"
                />
                <ul id="address-suggestions" class="absolute z-50 w-full mt-1 rounded-lg overflow-hidden shadow-lg hidden"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark); max-height: 280px; overflow-y: auto;"
                  role="listbox"
                ></ul>
              </div>
              <div>
                <label for="zip" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">ZIP Code</label>
                <input type="text" id="zip" name="zip" autocomplete="postal-code" inputmode="numeric"
                  pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                  placeholder="14624"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Service Interest</label>
              <select id="service" name="service_interest"
                class="w-full px-4 py-3 rounded-lg text-white text-sm"
                style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
              >
                <option value="">Select a service...</option>
                {serviceOptions.map((opt) => <option>{opt.label}</option>)}
                <option value="Career Inquiry">Career Inquiry / Employment</option>
                <option>Other</option>
              </select>
            </div>

            <!-- Project detail fields — hidden for career inquiries, where none apply. -->
            <div id="project-fields" class="flex flex-col gap-6">
              <div>
                <label for="project-type" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">What Are You Looking to Build or Fix?</label>
                <select id="project-type" name="project_type"
                  class="w-full px-4 py-3 rounded-lg text-white text-sm"
                  style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                >
                  <option value="">Select a project type...</option>
                  {projectTypeOptions.map((opt) => <option>{opt}</option>)}
                </select>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="budget" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Approximate Budget</label>
                  <select id="budget" name="budget"
                    class="w-full px-4 py-3 rounded-lg text-white text-sm"
                    style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                  >
                    <option value="">Select a range...</option>
                    {budgetOptions.map((opt) => <option>{opt}</option>)}
                  </select>
                  <p class="text-xs mt-1.5" style="color: var(--color-text-muted);">
                    Optional, but it helps us design something you'll actually build.
                    <a href={url('/services/hardscaping/#investment')} style="color: var(--color-green-bright); text-decoration: underline; text-underline-offset: 2px;">See typical ranges</a>.
                  </p>
                </div>
                <div>
                  <label for="timing" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">When Would You Like It Done?</label>
                  <select id="timing" name="timing"
                    class="w-full px-4 py-3 rounded-lg text-white text-sm"
                    style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                  >
                    <option value="">Select timing...</option>
                    {timingOptions.map((opt) => <option>{opt}</option>)}
                  </select>
                </div>
              </div>
            </div>

            <div id="resume-upload-group" class="hidden">
              <label for="resume" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Attach Resume <span class="font-normal" style="color: var(--color-text-muted);">(optional)</span></label>
              <input type="file" id="resume" name="attachment"
                accept=".pdf,.doc,.docx"
                class="w-full px-4 py-3 rounded-lg text-white text-sm cursor-pointer"
                style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
              />
              <p class="text-xs mt-1.5" style="color: var(--color-text-muted);">PDF, DOC, or DOCX — 5 MB max</p>
            </div>

            <div>
              <label for="how-heard" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">How Did You Hear About Us?</label>
              <select id="how-heard" name="how_heard"
                class="w-full px-4 py-3 rounded-lg text-white text-sm"
                style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
              >
                <option value="">Select...</option>
                <option>Google Search</option>
                <option>Neighbor / Word of Mouth</option>
                <option>Saw Your Work in My Neighborhood</option>
                <option>Door Hanger / Mailer</option>
                <option>Facebook / Instagram</option>
                <option>NextDoor</option>
                <option>Yard Sign</option>
                <option>Drove Past a Job Site</option>
                <option>Returning Customer</option>
                <option>Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold mb-2" style="color: var(--color-text-light);">Tell Us About It <span style="color: var(--color-green-bright);">*</span></label>
              <textarea id="message" name="message" rows="5" required
                class="w-full px-4 py-3 rounded-lg text-white text-sm resize-y"
                style="background: var(--color-bg-dark-elevated); border: 1px solid var(--color-border-dark);"
                placeholder="What's the space like today, what would you like it to do, and is there anything giving you trouble (drainage, settling, access)?"
              ></textarea>
            </div>

            {turnstileSiteKey && (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
            )}

            <button type="submit" class="btn btn-primary btn-lg self-start">
              Send Message
            </button>
            <div id="form-status" role="status" aria-live="polite" class="text-sm mt-2" style="min-height: 1.5em;"></div>
          </form>
        </div>

        <!-- Contact Sidebar -->
        <div>
          <div class="rounded-xl p-8 mb-8" style="background: var(--color-bg-accent-card); border: 1px solid var(--color-border-accent);">
            <h2 class="text-lg mb-6">Contact Information</h2>
            <div class="flex flex-col gap-5">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span class="text-sm" style="color: var(--color-text-light);">{company.address.street}<br />{company.address.city}, {company.address.state} {company.address.zip}</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.8.36 1.58.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.83.28 1.61.51 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href={company.phoneHref} class="text-sm hover:text-white" style="color: var(--color-text-light);">{company.phone}</a>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <a href={`mailto:${company.email}`} class="text-sm hover:text-white" style="color: var(--color-text-light);">{company.email}</a>
              </div>
            </div>
          </div>

          <div class="rounded-xl p-8" style="background: var(--color-bg-accent-card); border: 1px solid var(--color-border-accent);">
            <h2 class="text-lg mb-4">Office Hours</h2>
            <div class="flex flex-col gap-2 text-sm" style="color: var(--color-text-muted);">
              {company.hours.weekdays && (
                <div class="flex justify-between">
                  <span>Monday – Friday</span>
                  <span>{formatTime(company.hours.weekdays.open)} – {formatTime(company.hours.weekdays.close)}</span>
                </div>
              )}
              <div class="flex justify-between">
                <span>Saturday – Sunday</span>
                <span>{company.hours.saturday ? `${formatTime(company.hours.saturday.open)} – ${formatTime(company.hours.saturday.close)}` : 'Closed'}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 section-dark">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Common Questions</p>
        <h2 class="section-title">FREQUENTLY <span class="text-green">ASKED</span></h2>
      </div>
      <div class="max-w-3xl mx-auto flex flex-col gap-6 stagger-children">
        {faqItems.map((faq) => (
          <div class="p-6 rounded-xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
            <h3 class="text-base mb-3" style="font-family: var(--font-body); font-weight: 700; text-transform: none; line-height: 1.4;">{faq.question}</h3>
            <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.8;">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Turnstile API — only loaded when site key is configured */}
  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
</BaseLayout>

<style is:global>
  #address-suggestions li {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--color-text-light);
    border-bottom: 1px solid var(--color-border-dark);
    transition: background-color 0.15s;
  }
  #address-suggestions li:last-child {
    border-bottom: none;
  }
  #address-suggestions li:hover,
  #address-suggestions li[aria-selected="true"] {
    background: var(--color-bg-dark-card);
  }
</style>

<script>
  const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
  const resumeGroup = document.getElementById('resume-upload-group');
  const projectFields = document.getElementById('project-fields');

  function syncCareerFields() {
    if (!serviceSelect) return;
    const isCareer = serviceSelect.value === 'Career Inquiry';
    resumeGroup?.classList.toggle('hidden', !isCareer);
    // Project type / budget / timing are meaningless on a job application.
    projectFields?.classList.toggle('hidden', isCareer);
  }

  serviceSelect?.addEventListener('change', syncCareerFields);

  // Pre-select Service Interest based on ?service=<slug> URL param. Slugs come
  // from internal links (service hero CTAs, careers page) and external paid-ad
  // destination URLs (Meta/Google ads point to /contact/?service=hardscaping
  // etc.). The slug\u2192label map is serialized onto the form from services.ts, so
  // adding a service no longer requires editing this script.
  if (serviceSelect) {
    const formEl = document.getElementById('contact-form') as HTMLFormElement | null;
    const params = new URLSearchParams(window.location.search);
    const serviceParam = params.get('service');
    if (serviceParam) {
      let slugToOption: Record<string, string> = {};
      try {
        slugToOption = JSON.parse(formEl?.dataset.serviceMap || '{}');
      } catch {
        slugToOption = {};
      }
      slugToOption.careers = 'Career Inquiry';

      const targetOption = slugToOption[serviceParam];
      if (targetOption) {
        serviceSelect.value = targetOption;
        syncCareerFields();
        if (serviceParam === 'careers') {
          const messageEl = document.getElementById('message') as HTMLTextAreaElement | null;
          if (messageEl && !messageEl.value) {
            messageEl.placeholder = 'Tell us a bit about yourself, your experience, and what kind of role you\u2019re interested in...';
          }
        }
      }
    }
  }

  const addressInput = document.getElementById('address') as HTMLInputElement | null;
  const suggestionsEl = document.getElementById('address-suggestions') as HTMLUListElement | null;

  if (addressInput && suggestionsEl) {
    let debounceTimer: ReturnType<typeof setTimeout>;
    let sessionToken = crypto.randomUUID();
    let activeIndex = -1;

    function escHtml(s: string) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function escAttr(s: string) { return escHtml(s).replace(/"/g, '&quot;'); }

    async function fetchSuggestions(input: string) {
      try {
        const res = await fetch('/api/address-suggest/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ input, sessionToken }),
        });
        if (!res.ok) return;
        const data = await res.json();
        renderSuggestions(data.suggestions || []);
      } catch {
        hideSuggestions();
      }
    }

    function renderSuggestions(suggestions: any[]) {
      if (!suggestions.length) { hideSuggestions(); return; }
      activeIndex = -1;
      suggestionsEl!.innerHTML = suggestions.slice(0, 5).map((s: any, i: number) => {
        const pred = s.placePrediction;
        const main = pred?.structuredFormat?.mainText?.text || pred?.text?.text || '';
        const secondary = pred?.structuredFormat?.secondaryText?.text || '';
        const full = pred?.text?.text || main;
        return `<li role="option" id="addr-opt-${i}" data-value="${escAttr(full)}">${escHtml(main)}${secondary ? `<span style="display:block;font-size:0.75rem;margin-top:2px;color:var(--color-text-muted);">${escHtml(secondary)}</span>` : ''}</li>`;
      }).join('');
      suggestionsEl!.classList.remove('hidden');
      addressInput!.setAttribute('aria-expanded', 'true');
    }

    function selectSuggestion(value: string) {
      addressInput!.value = value;
      hideSuggestions();
      sessionToken = crypto.randomUUID();
    }

    function hideSuggestions() {
      suggestionsEl!.classList.add('hidden');
      suggestionsEl!.innerHTML = '';
      activeIndex = -1;
      addressInput?.setAttribute('aria-expanded', 'false');
      addressInput?.removeAttribute('aria-activedescendant');
    }

    function updateActive() {
      const items = suggestionsEl!.querySelectorAll('li');
      items.forEach((li, i) => {
        if (i === activeIndex) {
          li.setAttribute('aria-selected', 'true');
          addressInput?.setAttribute('aria-activedescendant', li.id);
        } else {
          li.removeAttribute('aria-selected');
        }
      });
    }

    addressInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = addressInput.value.trim();
      if (query.length < 3) { hideSuggestions(); return; }
      debounceTimer = setTimeout(() => fetchSuggestions(query), 300);
    });

    suggestionsEl.addEventListener('click', (e: Event) => {
      const li = (e.target as HTMLElement).closest('li');
      if (li) selectSuggestion(li.dataset.value || '');
    });

    addressInput.addEventListener('keydown', (e: KeyboardEvent) => {
      const items = suggestionsEl!.querySelectorAll('li');
      if (!items.length || suggestionsEl!.classList.contains('hidden')) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, items.length - 1);
        updateActive();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, -1);
        updateActive();
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        selectSuggestion((items[activeIndex] as HTMLElement).dataset.value || '');
      } else if (e.key === 'Escape') {
        hideSuggestions();
      }
    });

    document.addEventListener('click', (e: Event) => {
      if (!addressInput.contains(e.target as Node) && !suggestionsEl.contains(e.target as Node)) {
        hideSuggestions();
      }
    });

    // Expose reset for form clear
    (window as any).__resetAddressAutocomplete = () => { sessionToken = crypto.randomUUID(); };
  }

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = reader.result as string;
        // Strip the data URL prefix, keep only the base64 payload
        resolve(result.includes(',') ? result.split(',')[1] : result);
      };
      reader.onerror = () => reject(new Error('Failed to read file.'));
      reader.readAsDataURL(file);
    });
  }

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formStatus = document.getElementById('form-status');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = btn.textContent;
      const turnstileWidget = form.querySelector('.cf-turnstile') as HTMLElement | null;

      // Client-side Turnstile gate
      const turnstileToken = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value || '';
      if (turnstileWidget && !turnstileToken) {
        if (formStatus) {
          formStatus.textContent = 'Please complete the verification challenge above.';
          formStatus.style.color = '#e67e22';
        }
        return;
      }

      // Client-side file size check
      const fileInput = form.querySelector<HTMLInputElement>('[name="attachment"]');
      const file = fileInput?.files?.[0] && fileInput.files[0].size > 0 ? fileInput.files[0] : null;
      if (file && file.size > 5 * 1024 * 1024) {
        if (formStatus) {
          formStatus.textContent = 'Resume is too large. Please upload a file under 5 MB.';
          formStatus.style.color = '#e67e22';
        }
        return;
      }

      btn.textContent = 'Sending...';
      btn.disabled = true;
      if (formStatus) { formStatus.textContent = 'Sending your message...'; formStatus.style.color = ''; }

      // Shared event_id for Meta browser pixel + server CAPI dedup
      const leadEventId = (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function')
        ? crypto.randomUUID()
        : `lead-${Date.now()}-${Math.random().toString(36).slice(2)}`;

      try {
        const isCareerSubmit =
          (form.querySelector<HTMLSelectElement>('[name="service_interest"]')?.value || '') === 'Career Inquiry';

        const payload: Record<string, unknown> = {
          firstName: (form.querySelector<HTMLInputElement>('[name="first_name"]')?.value || '').trim(),
          lastName: (form.querySelector<HTMLInputElement>('[name="last_name"]')?.value || '').trim(),
          email: (form.querySelector<HTMLInputElement>('[name="email"]')?.value || '').trim(),
          phone: (form.querySelector<HTMLInputElement>('[name="phone"]')?.value || '').trim(),
          contactPreference: (form.querySelector<HTMLInputElement>('[name="contact_preference"]:checked')?.value || '').trim(),
          address: (form.querySelector<HTMLInputElement>('[name="address"]')?.value || '').trim(),
          zip: (form.querySelector<HTMLInputElement>('[name="zip"]')?.value || '').trim(),
          service: (form.querySelector<HTMLSelectElement>('[name="service_interest"]')?.value || '').trim(),
          // Project detail fields are hidden for career inquiries; sending a
          // stale value from a switched selection would mislabel the lead.
          projectType: isCareerSubmit ? '' : (form.querySelector<HTMLSelectElement>('[name="project_type"]')?.value || '').trim(),
          budget: isCareerSubmit ? '' : (form.querySelector<HTMLSelectElement>('[name="budget"]')?.value || '').trim(),
          timing: isCareerSubmit ? '' : (form.querySelector<HTMLSelectElement>('[name="timing"]')?.value || '').trim(),
          howHeard: (form.querySelector<HTMLSelectElement>('[name="how_heard"]')?.value || '').trim(),
          message: (form.querySelector<HTMLTextAreaElement>('[name="message"]')?.value || '').trim(),
          // First-touch campaign parameters captured by TrackingScripts on the
          // landing page — the submit URL usually has none of them.
          attribution: typeof (window as any).__wplAttribution === 'function'
            ? (window as any).__wplAttribution()
            : {},
          turnstileToken,
          eventId: leadEventId,
        };

        if (file) {
          payload.resume = {
            name: file.name,
            type: file.type,
            data: await fileToBase64(file),
          };
        }

        const response = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.success) {
          const attribution = (payload.attribution || {}) as Record<string, string>;
          // GA4 form_submit always fires (internal traffic filtered via data filter).
          // Keep these parameter names aligned with GA4 custom dimensions.
          if (typeof (window as any).gtag === 'function') {
            const serviceInterest = String(payload.service || 'Not specified');
            const howHeard = String(payload.howHeard || 'Not specified');
            const formType = serviceInterest === 'Career Inquiry' ? 'career_inquiry' : 'estimate_request';
            (window as any).gtag('event', 'form_submit', {
              event_category: 'engagement',
              form_name: 'contact',
              form_type: formType,
              service_interest: serviceInterest,
              how_heard: howHeard,
              project_type: String(payload.projectType || 'Not specified'),
              budget_band: String(payload.budget || 'Not specified'),
              project_timing: String(payload.timing || 'Not specified'),
              lead_utm_source: attribution.utm_source || 'direct',
              lead_utm_medium: attribution.utm_medium || 'none',
              lead_utm_campaign: attribution.utm_campaign || 'none',
            });
            // Microsoft Ads primary lead event — only after the server accepts
            // the inquiry, and never for internal traffic.
            if ((window as any).uetq && !(window as any).__wplInternal) {
              (window as any).uetq.push('event', 'request_quote', {
                event_category: 'lead',
                event_label: formType,
                event_value: 50,
                revenue_value: 50,
                currency: 'USD',
              });
            }
            // Google Ads conversion — blocked for internal traffic
            const sendTo = form.dataset.adsSendTo;
            if (sendTo && !(window as any).__wplInternal) (window as any).gtag('event', 'conversion', { send_to: sendTo, value: 50.0, currency: 'USD' });
          }
          // Meta event — blocked for internal traffic.
          // eventID matches the server-side CAPI Lead payload for dedup.
          if (typeof (window as any).fbq === 'function' && !(window as any).__wplInternal) {
            (window as any).fbq(
              'track',
              'Lead',
              {
                service_interest: String(payload.service || 'Not specified'),
                project_type: String(payload.projectType || 'Not specified'),
                budget_band: String(payload.budget || 'Not specified'),
              },
              { eventID: leadEventId },
            );
          }
          btn.textContent = '\u2713 Message Sent!';
          btn.style.background = 'var(--color-green-primary)';
          if (formStatus) { formStatus.textContent = 'Your message has been sent successfully. We\u2019ll be in touch soon!'; formStatus.style.color = 'var(--color-green-bright)'; }
          form.reset();
          syncCareerFields();
          if (typeof (window as any).__resetAddressAutocomplete === 'function') (window as any).__resetAddressAutocomplete();
          if (turnstileWidget && typeof (window as any).turnstile?.reset === 'function') {
            (window as any).turnstile.reset(turnstileWidget);
          }
          setTimeout(() => {
            btn.textContent = originalText;
            btn.style.background = '';
            btn.disabled = false;
          }, 4000);
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : '';
        btn.textContent = 'Error \u2014 Please Call Us';
        btn.style.background = '#c0392b';
        if (formStatus) {
          formStatus.textContent = msg || 'There was an error sending your message. Please call us instead.';
          formStatus.style.color = '#c0392b';
        }
        setTimeout(() => {
          btn.textContent = originalText;
          btn.style.background = '';
          btn.disabled = false;
        }, 4000);
      }
    });
  }
</script>
