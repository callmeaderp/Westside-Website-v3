---
import BaseLayout from '@layouts/BaseLayout.astro';

const products = [
  { id: 'preen', label: 'Preen', unit: 'lb', step: '0.1', placeholder: '0' },
  { id: 'prosecutor-pro', label: 'Prosecutor Pro', unit: 'fl oz', step: '0.1', placeholder: '0' },
  { id: 'three-way', label: '3-Way', unit: 'fl oz', step: '0.1', placeholder: '0' },
  { id: 'dimension', label: 'Dimension', unit: 'lb', step: '0.1', placeholder: '0' },
];
---

<BaseLayout
  title="Chemical Record Entry | Westside Professional Landscape"
  description="Private field intake form for Westside chemical application records."
  noindex={true}
>
  <section class="min-h-screen bg-[#0f1712] px-4 pb-16 pt-24 text-white sm:px-6 lg:pt-28">
    <div class="mx-auto w-full max-w-3xl">
      <div class="mb-6 rounded-3xl border border-white/10 bg-white/[0.06] p-5 shadow-2xl shadow-black/30 sm:p-7">
        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.24em] text-green-bright">Westside Plant Health</p>
        <h1 class="mb-3 text-4xl leading-none sm:text-5xl">Chemical Record</h1>
        <p class="max-w-2xl text-base leading-relaxed text-white/75">
          Quick field intake for product amounts used after a visit. Entries submit to the office log when online;
          if service drops, this page saves them on this device and sends them later.
        </p>
      </div>

      <div id="offlineBanner" class="mb-4 hidden rounded-2xl border border-amber-300/30 bg-amber-400/15 px-4 py-3 text-sm font-semibold text-amber-100">
        Offline mode: new entries will be saved on this device until internet returns.
      </div>

      <div id="queueBanner" class="mb-4 hidden rounded-2xl border border-sky-300/30 bg-sky-400/15 px-4 py-3 text-sm text-sky-100">
        <span id="queueText"></span>
        <button type="button" id="syncNow" class="ml-2 font-bold underline decoration-sky-200/70 underline-offset-4">Sync now</button>
      </div>

      <form id="chemicalRecordForm" class="space-y-5 rounded-3xl border border-white/10 bg-[#151f18] p-5 shadow-2xl shadow-black/30 sm:p-7" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field-label">
            Submitter
            <select id="submitter" name="submitter" class="field-input" required>
              <option value="">Choose name</option>
              <option value="Joshua">Joshua</option>
              <option value="Nick">Nick</option>
              <option value="Mike">Mike</option>
              <option value="Brad">Brad</option>
            </select>
          </label>

          <label class="field-label">
            Application date
            <input id="applicationDate" name="applicationDate" type="date" class="field-input" required />
          </label>
        </div>

        <label class="field-label">
          Client, address, or Jobber visit
          <input
            id="client"
            name="client"
            type="text"
            class="field-input"
            autocomplete="off"
            placeholder="Smith / 123 Main / Harbor Hill"
            required
          />
        </label>

        <fieldset class="space-y-3">
          <legend class="mb-3 text-lg font-bold text-white">Products used</legend>
          <p class="mb-4 text-sm text-white/65">Check each product used, then enter the amount in the shown unit.</p>

          {products.map((product) => (
            <div class="product-card" data-product-card={product.id}>
              <label class="flex cursor-pointer items-center gap-3 text-lg font-bold text-white">
                <input
                  type="checkbox"
                  class="product-checkbox h-5 w-5 rounded border-white/30 accent-green-bright"
                  name="product"
                  value={product.id}
                  data-product-id={product.id}
                />
                <span>{product.label}</span>
              </label>
              <div class="product-details hidden" data-product-details={product.id}>
                <label class="field-label mt-3">
                  Amount used ({product.unit})
                  <div class="flex items-center gap-3">
                    <input
                      type="number"
                      inputmode="decimal"
                      min="0"
                      step={product.step}
                      class="field-input product-amount"
                      placeholder={product.placeholder}
                      data-product-amount={product.id}
                      data-product-label={product.label}
                      data-product-unit={product.unit}
                    />
                    <span class="min-w-14 rounded-xl bg-white/10 px-3 py-3 text-center font-bold text-white/80">{product.unit}</span>
                  </div>
                </label>
              </div>
            </div>
          ))}

          <div class="product-card" data-product-card="other">
            <label class="flex cursor-pointer items-center gap-3 text-lg font-bold text-white">
              <input
                type="checkbox"
                class="product-checkbox h-5 w-5 rounded border-white/30 accent-green-bright"
                name="product"
                value="other"
                data-product-id="other"
              />
              <span>Other</span>
            </label>
            <div class="product-details hidden" data-product-details="other">
              <div class="mt-3 grid gap-3 sm:grid-cols-[1.2fr_0.8fr_0.7fr]">
                <label class="field-label">
                  Product name
                  <input type="text" id="otherProductName" class="field-input" placeholder="Product name" />
                </label>
                <label class="field-label">
                  Amount used
                  <input type="number" id="otherAmount" inputmode="decimal" min="0" step="0.1" class="field-input" placeholder="0" />
                </label>
                <label class="field-label">
                  Unit
                  <input type="text" id="otherUnit" class="field-input" placeholder="lb / oz" />
                </label>
              </div>
            </div>
          </div>
        </fieldset>

        <label class="field-label">
          Notes <span class="font-normal text-white/45">(optional)</span>
          <textarea id="notes" name="notes" class="field-input min-h-28 resize-y" placeholder="Anything Katrina should know"></textarea>
        </label>

        <button id="submitButton" type="submit" class="btn btn-primary btn-lg w-full text-center disabled:cursor-not-allowed disabled:opacity-60">
          Submit record
        </button>

        <div id="statusMessage" class="hidden rounded-2xl px-4 py-3 text-sm font-semibold" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <style>
    .field-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.82);
    }

    .field-input {
      margin-top: 0.45rem;
      width: 100%;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.08);
      padding: 0.85rem 1rem;
      color: #fff;
      font: inherit;
      outline: none;
      transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

    .field-input:focus {
      border-color: rgba(108, 197, 81, 0.8);
      background: rgba(255, 255, 255, 0.11);
      box-shadow: 0 0 0 3px rgba(108, 197, 81, 0.18);
    }

    .field-input::placeholder {
      color: rgba(255, 255, 255, 0.38);
    }

    select.field-input option {
      color: #111;
    }

    .product-card {
      border-radius: 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.11);
      background: rgba(255, 255, 255, 0.055);
      padding: 1rem;
    }

    .product-card.is-selected {
      border-color: rgba(108, 197, 81, 0.55);
      background: rgba(108, 197, 81, 0.09);
    }
  </style>

  <script>
    type StoredRecord = {
      localId: string;
      submittedAtLocal: string;
      submitter: string;
      applicationDate: string;
      client: string;
      notes: string;
      products: Array<{ name: string; quantity: number; unit: string }>;
    };

    const form = document.querySelector<HTMLFormElement>('#chemicalRecordForm')!;
    const submitButton = document.querySelector<HTMLButtonElement>('#submitButton')!;
    const statusMessage = document.querySelector<HTMLDivElement>('#statusMessage')!;
    const submitter = document.querySelector<HTMLSelectElement>('#submitter')!;
    const applicationDate = document.querySelector<HTMLInputElement>('#applicationDate')!;
    const client = document.querySelector<HTMLInputElement>('#client')!;
    const notes = document.querySelector<HTMLTextAreaElement>('#notes')!;
    const offlineBanner = document.querySelector<HTMLDivElement>('#offlineBanner')!;
    const queueBanner = document.querySelector<HTMLDivElement>('#queueBanner')!;
    const queueText = document.querySelector<HTMLSpanElement>('#queueText')!;
    const syncNow = document.querySelector<HTMLButtonElement>('#syncNow')!;
    const queueKey = 'westsideChemicalRecordQueue';
    const submitterKey = 'westsideChemicalRecordSubmitter';

    function todayLocalIso(): string {
      const now = new Date();
      const offset = now.getTimezoneOffset() * 60000;
      return new Date(now.getTime() - offset).toISOString().slice(0, 10);
    }

    function getQueue(): StoredRecord[] {
      try {
        return JSON.parse(localStorage.getItem(queueKey) || '[]');
      } catch {
        return [];
      }
    }

    function setQueue(records: StoredRecord[]): void {
      localStorage.setItem(queueKey, JSON.stringify(records));
      updateQueueBanner();
    }

    function showStatus(kind: 'success' | 'warning' | 'error', message: string): void {
      const classes = {
        success: 'border border-green-300/30 bg-green-400/15 text-green-100',
        warning: 'border border-amber-300/30 bg-amber-400/15 text-amber-100',
        error: 'border border-red-300/30 bg-red-400/15 text-red-100',
      };
      statusMessage.className = `rounded-2xl px-4 py-3 text-sm font-semibold ${classes[kind]}`;
      statusMessage.textContent = message;
      statusMessage.classList.remove('hidden');
    }

    function updateConnectionUi(): void {
      offlineBanner.classList.toggle('hidden', navigator.onLine);
    }

    function updateQueueBanner(): void {
      const count = getQueue().length;
      queueBanner.classList.toggle('hidden', count === 0);
      queueText.textContent = count === 1
        ? '1 saved entry is waiting to sync.'
        : `${count} saved entries are waiting to sync.`;
    }

    function setDetailsRequired(productId: string, required: boolean): void {
      const details = document.querySelector<HTMLElement>(`[data-product-details="${productId}"]`);
      const card = document.querySelector<HTMLElement>(`[data-product-card="${productId}"]`);
      if (!details || !card) return;

      details.classList.toggle('hidden', !required);
      card.classList.toggle('is-selected', required);
      details.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        if (input.id === 'otherUnit') {
          input.required = false;
        } else {
          input.required = required;
        }
      });
    }

    function wireProductToggles(): void {
      document.querySelectorAll<HTMLInputElement>('.product-checkbox').forEach((checkbox) => {
        checkbox.addEventListener('change', () => setDetailsRequired(checkbox.dataset.productId || '', checkbox.checked));
      });
    }

    function collectRecord(): StoredRecord | null {
      const products: StoredRecord['products'] = [];

      document.querySelectorAll<HTMLInputElement>('.product-amount').forEach((input) => {
        const productId = input.dataset.productAmount || '';
        const checkbox = document.querySelector<HTMLInputElement>(`.product-checkbox[data-product-id="${productId}"]`);
        if (!checkbox?.checked) return;

        const value = Number(input.value);
        if (!Number.isFinite(value) || value <= 0) return;
        products.push({
          name: input.dataset.productLabel || productId,
          quantity: value,
          unit: input.dataset.productUnit || '',
        });
      });

      const otherCheckbox = document.querySelector<HTMLInputElement>('.product-checkbox[data-product-id="other"]');
      if (otherCheckbox?.checked) {
        const otherProductName = document.querySelector<HTMLInputElement>('#otherProductName')!.value.trim();
        const otherAmount = Number(document.querySelector<HTMLInputElement>('#otherAmount')!.value);
        const otherUnit = document.querySelector<HTMLInputElement>('#otherUnit')!.value.trim();
        if (otherProductName && Number.isFinite(otherAmount) && otherAmount > 0) {
          products.push({ name: otherProductName, quantity: otherAmount, unit: otherUnit || 'unspecified' });
        }
      }

      if (!products.length) {
        showStatus('error', 'Choose at least one product and enter an amount greater than zero.');
        return null;
      }

      const record: StoredRecord = {
        localId: crypto.randomUUID(),
        submittedAtLocal: new Date().toISOString(),
        submitter: submitter.value,
        applicationDate: applicationDate.value,
        client: client.value.trim(),
        notes: notes.value.trim(),
        products,
      };

      return record;
    }

    async function sendRecord(record: StoredRecord): Promise<void> {
      const response = await fetch('/api/chemical-record/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(record),
      });
      if (!response.ok) {
        let detail = 'Unable to submit record.';
        try {
          const body = await response.json() as { message?: string };
          detail = body.message || detail;
        } catch {
          detail = await response.text() || detail;
        }
        throw new Error(detail);
      }
    }

    function saveOffline(record: StoredRecord): void {
      setQueue([...getQueue(), record]);
    }

    function resetFormKeepDefaults(): void {
      const savedSubmitter = submitter.value;
      form.reset();
      submitter.value = savedSubmitter;
      applicationDate.value = todayLocalIso();
      document.querySelectorAll<HTMLInputElement>('.product-checkbox').forEach((checkbox) => {
        setDetailsRequired(checkbox.dataset.productId || '', false);
      });
      localStorage.setItem(submitterKey, savedSubmitter);
      client.focus();
    }

    async function flushQueue(): Promise<void> {
      if (!navigator.onLine) {
        updateConnectionUi();
        return;
      }

      const queued = getQueue();
      if (!queued.length) return;

      const remaining: StoredRecord[] = [];
      for (const record of queued) {
        try {
          await sendRecord(record);
        } catch {
          remaining.push(record);
        }
      }
      setQueue(remaining);
      if (remaining.length === 0) {
        showStatus('success', 'Saved offline entries synced successfully.');
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      statusMessage.classList.add('hidden');

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const record = collectRecord();
      if (!record) return;

      submitButton.disabled = true;
      submitButton.textContent = navigator.onLine ? 'Submitting…' : 'Saving offline…';

      try {
        if (!navigator.onLine) {
          saveOffline(record);
          showStatus('warning', 'No internet right now. Entry saved on this device and will submit automatically when online.');
        } else {
          await sendRecord(record);
          showStatus('success', 'Record submitted.');
          await flushQueue();
        }
        resetFormKeepDefaults();
      } catch (error) {
        saveOffline(record);
        const message = error instanceof Error ? error.message : 'Submission failed.';
        showStatus('warning', `${message} Entry saved on this device and will retry later.`);
        resetFormKeepDefaults();
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Submit record';
        updateConnectionUi();
        updateQueueBanner();
      }
    });

    submitter.addEventListener('change', () => {
      if (submitter.value) localStorage.setItem(submitterKey, submitter.value);
    });

    function registerServiceWorker(): void {
      if (!('serviceWorker' in navigator)) return;
      navigator.serviceWorker.register('/chemical-record-sw.js', { scope: '/' }).catch(() => {
        // Offline queueing still works without the shell cache.
      });
    }

    syncNow.addEventListener('click', () => flushQueue());
    window.addEventListener('online', () => {
      updateConnectionUi();
      flushQueue();
    });
    window.addEventListener('offline', updateConnectionUi);

    applicationDate.value = todayLocalIso();
    submitter.value = localStorage.getItem(submitterKey) || '';
    wireProductToggles();
    registerServiceWorker();
    updateConnectionUi();
    updateQueueBanner();
    if (navigator.onLine) flushQueue();
  </script>
</BaseLayout>
