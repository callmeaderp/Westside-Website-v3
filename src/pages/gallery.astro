---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import MediaGrid from '@components/MediaGrid.astro';
import MediaLightbox from '@components/MediaLightbox.astro';
import { gallery, galleryCategories, matchesFilter } from '@data/gallery';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

/** Only offer filters that have something behind them. */
const filters = galleryCategories
  .map((cat) => ({ ...cat, count: gallery.filter((item) => matchesFilter(item, cat.value)).length }))
  .filter((cat) => cat.count > 0);

const videoCount = gallery.filter((item) => item.video).length;
const photoCount = gallery.length - videoCount;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Gallery', item: siteUrl('/gallery') },
  ],
};
---

<BaseLayout
  title="Landscaping Photo & Video Gallery | Rochester NY | Westside"
  description="Photos and drone video of real Westside work: landscape installations, maintained lawns, patios and walls, synthetic turf and putting greens, and commercial grounds."
  ogImage={getPhoto('hero-gallery-putting-green-estate.webp')}
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Our Work"
    heading="ROCHESTER LANDSCAPING GALLERY"
    intro="Photos and drone video from real Westside jobs: new landscapes, lawns we maintain, patios and walls, synthetic turf, and commercial grounds."
    image={getPhoto('hero-gallery-putting-green-estate.webp')}
    buttons={[
      { text: 'Explore Featured Projects', href: '/projects/', style: 'primary' },
      { text: 'Start Your Project', href: '/contact/', style: 'outline' },
    ]}
  />

  <section class="py-8 section-dark">
    <div class="site-container">
      <p class="text-center text-sm" style="color: var(--color-text-muted); line-height: 1.8;">
        Looking for construction details rather than the full photo collection? Our <a href={url('/projects/')} class="font-semibold" style="color: var(--color-green-bright);">featured projects</a> pair selected completed work with visible scope and current planning ranges for comparable work.
      </p>
    </div>
  </section>

  <section class="py-20 section-dark-alt">
    <div class="site-container-wide">
      <div class="flex flex-wrap justify-center gap-3 mb-6" role="group" aria-label="Filter the gallery">
        {filters.map((cat) => (
          <button
            type="button"
            class:list={[
              'filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all duration-200 cursor-pointer',
              cat.value === 'all' ? 'active' : '',
            ]}
            data-filter={cat.value}
            aria-pressed={cat.value === 'all' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <p class="text-center text-sm mb-10" style="color: var(--color-text-muted);" id="gallery-status" aria-live="polite">
        {photoCount} photos and {videoCount} drone videos from real jobs. Select any one to see it full size.
      </p>

      <MediaGrid items={gallery} variant="gallery" id="gallery-grid" />
    </div>
  </section>

  <MediaLightbox />

  <CtaBanner />
</BaseLayout>

<script>
  // Gallery filter. ?category=<value> deep-links from the service-page strips.
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const galleryGrid = document.getElementById('gallery-grid');
  const galleryItems = Array.from(document.querySelectorAll<HTMLElement>('#gallery-grid .media-item'));
  const status = document.getElementById('gallery-status');
  const defaultStatus = status?.textContent ?? '';
  const hideTimeouts = new WeakMap<Element, number>();

  function applyFilter(filter: string, moveFocus = false) {
    const btn = filterBtns.find((b) => b.dataset.filter === filter);
    if (!btn) return;
    filterBtns.forEach((b) => {
      const on = b === btn;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (moveFocus) btn.focus();

    // Span hints only make sense for the full, curated order.
    galleryGrid?.classList.toggle('filtered', filter !== 'all');

    let shown = 0;
    galleryItems.forEach((el) => {
      const pending = hideTimeouts.get(el);
      if (pending) {
        clearTimeout(pending);
        hideTimeouts.delete(el);
      }
      const match =
        filter === 'all' ||
        (filter === 'video' ? el.dataset.kind === 'video' : el.dataset.category === filter);
      if (match) {
        shown++;
        el.style.display = '';
        requestAnimationFrame(() => (el.style.opacity = '1'));
      } else {
        el.style.opacity = '0';
        hideTimeouts.set(
          el,
          window.setTimeout(() => {
            el.style.display = 'none';
            hideTimeouts.delete(el);
          }, 300)
        );
      }
    });

    if (status) {
      status.textContent =
        filter === 'all' ? defaultStatus : `Showing ${shown} of ${galleryItems.length}: ${btn.textContent?.trim()}.`;
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
  });

  const requested = new URLSearchParams(window.location.search).get('category');
  if (requested && filterBtns.some((b) => b.dataset.filter === requested)) {
    applyFilter(requested);
  }
</script>

<style>
  .filter-btn {
    background: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-dark);
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: linear-gradient(135deg, #6CC551 0%, #00863F 100%);
    border-color: transparent;
    color: white;
  }
</style>
