---
/**
 * Homepage — Westside Professional Landscape
 * Full-height hero, service cards, testimonials, stats, CTA.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { Image } from 'astro:assets';
import { company } from '@data/company';
import { services } from '@data/services';
import { testimonials } from '@data/testimonials';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

// Build homepage JSON-LD (LocalBusiness + reviews + offer catalog)
const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LandscapingBusiness',
  '@id': `${siteUrl('/')}#business`,
  name: company.name,
  url: company.url,
  telephone: company.phoneTel,
  email: company.email,
  description: company.description,
  logo: siteUrl('/leaf-green.svg'),
  image: siteUrl(getPhoto('hero-home.webp').src),
  priceRange: company.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    addressLocality: company.address.city,
    addressRegion: company.address.state,
    postalCode: company.address.zip,
    addressCountry: company.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.latitude,
    longitude: company.geo.longitude,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: company.hours.weekdays?.open,
    closes: company.hours.weekdays?.close,
  }],
  foundingDate: String(company.foundingYear),
  areaServed: company.areasServed.map((city) => ({
    '@type': 'City',
    name: city,
    ...(city === 'Rochester' ? { containedInPlace: { '@type': 'State', name: 'New York' } } : {}),
  })),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: String(testimonials.length),
    bestRating: '5',
  },
  // Only mark up reviews that are visible on the page (Google requires
  // structured data to match visible content)
  review: testimonials.slice(0, 3).map((t) => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: String(t.rating) },
    author: { '@type': 'Person', name: t.author },
    reviewBody: t.text,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Landscaping Services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name },
    })),
  },
  sameAs: Object.values(company.social),
};
---

<BaseLayout
  title="Westside Professional Landscape | Rochester NY Landscaping"
  description={company.description}
  jsonLd={homepageJsonLd}
>
  <!-- ═══ HERO ═══ -->
  <Hero
    label="Full-Service Landscaping Since 2000"
    heading='ROCHESTER&apos;S PROFESSIONAL <span class="text-green">LANDSCAPING EXPERTS</span>'
    intro="Full-service landscaping, lawn care, and property management. Transforming outdoor spaces across Greater Rochester since 2000."
    image={getPhoto('hero-home.webp')}
    variant="full"
    buttons={[
      { text: 'Get a Free Estimate', href: url('/contact'), style: 'primary' },
      { text: 'Our Services', href: url('/services'), style: 'outline' },
    ]}
  />

  <!-- ═══ SERVICES OVERVIEW ═══ -->
  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">What We Do</p>
        <h2 class="section-title">COMPREHENSIVE LANDSCAPE <span class="text-green">SOLUTIONS</span></h2>
        <p class="section-subtitle mx-auto">
          From design through year-round maintenance, we handle every aspect of your outdoor space.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {services.map((service) => (
          <a
            href={url(`/services/${service.slug}`)}
            class="group block rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg"
            style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <Image
                src={getPhoto(service.cardImage)}
                alt={service.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                widths={[400, 600]}
                sizes="(max-width: 768px) 100vw, 400px"
              />
            </div>
            <div class="p-6">
              <h3 class="text-lg mb-2">{service.shortName}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">
                {service.tagline}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT PREVIEW ═══ -->
  <section class="py-24 section-white">
    <div class="site-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="fade-in-left">
          <p class="section-label">Since 2000</p>
          <h2 class="section-title">ROCHESTER'S LOCALLY OWNED <span class="text-green">LANDSCAPE COMPANY</span></h2>
          <p class="mb-6" style="color: var(--color-text-body-dark); line-height: 1.8;">
            For over <strong>two decades</strong>, <strong>Westside Professional Landscape</strong> has been transforming properties across Greater Rochester.
            Our team brings expertise, creativity, and dedication to every project — from <em>intimate
            residential gardens</em> to expansive commercial landscapes.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={url('/about')} class="btn btn-primary btn-md">Learn More</a>
            <a href={url('/gallery')} class="btn btn-outline btn-md">View Our Work</a>
          </div>
        </div>
        <div class="fade-in-right">
          <Image
            src={getPhoto('gallery-striped-colonial.webp')}
            alt="Residential landscape by Westside Professional Landscape"
            class="rounded-xl shadow-lg"
            loading="lazy"
            widths={[600, 900]}
            sizes="(max-width: 1024px) 100vw, 600px"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="py-24 section-dark">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Client Reviews</p>
        <h2 class="section-title">WHAT OUR <span class="text-green">CLIENTS SAY</span></h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {testimonials.slice(0, 3).map((t) => (
          <div
            class="p-8 rounded-xl"
            style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);"
          >
            <div class="flex gap-1 mb-4">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="#6CC551" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="text-sm italic leading-relaxed mb-4" style="color: var(--color-text-light);">
              "{t.text}"
            </p>
            <p class="text-sm font-semibold" style="color: var(--color-green-bright);">
              — {t.author}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <CtaBanner />
</BaseLayout>
