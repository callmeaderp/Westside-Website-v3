---
/**
 * Privacy Policy page
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import { company } from '@data/company';
---

<BaseLayout
  title="Privacy Policy | Westside Professional Landscape"
  description="Privacy policy for Westside Professional Landscape. Learn how we collect, use, and protect your information."
>
  <Hero
    label="Legal"
    heading="PRIVACY POLICY"
    variant="utility"
  />

  <section class="py-16 section-dark-alt">
    <div class="site-container max-w-3xl">
      <div class="prose-content">
        <p class="text-sm mb-2" style="color: var(--color-text-muted);">Last updated: October 19, 2026</p>

        <h2>Information We Collect</h2>
        <p>When you use our website or contact us, we may collect:</p>
        <ul>
          <li><strong>Name, email, phone number, and address</strong> (when you submit a form or contact us)</li>
          <li>Information about your property and service needs</li>
          <li>For career inquiries: position of interest, availability, relevant experience, referral source and any résumé you choose to provide</li>
          <li>Usage data collected through cookies and analytics tools</li>
        </ul>

        <h2>How We Use Your Information</h2>
        <p>We use the information we collect to:</p>
        <ul>
          <li><strong>Respond to your inquiries</strong> and provide estimates</li>
          <li>Deliver and improve our landscaping services</li>
          <li>Send relevant updates about our services (with your consent)</li>
          <li>Improve our website and user experience</li>
        </ul>

        <h2>Career Inquiries</h2>
        <p>
          We use application information to review your interest, evaluate potential employment fit and contact you about recruiting.
          Your submission is delivered to our hiring team through our website and email service providers. A résumé is optional.
          Please do not include Social Security numbers, banking details or identity documents in this form.
          Application details are not included in our customer advertising-conversion events. We measure application submissions separately without sending the contents of your application to analytics.
          Contact us using the details below if you have questions about information you submitted.
        </p>

        <h2>Analytics &amp; Tracking</h2>
        <p>
          We use <strong>Google Analytics 4</strong> to understand how visitors use our website. Google Analytics uses cookies
          to collect usage data such as pages visited, time on site, and referral source. You can opt out by installing the
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics opt-out browser add-on</a>.
        </p>
        <p>
          We also use <strong>Meta (Facebook) Pixel</strong> to measure the effectiveness of our advertising campaigns
          and to understand how visitors interact with our website after seeing our ads on Facebook or Instagram. Meta Pixel
          collects data such as pages visited and actions taken (for example, submitting a contact form). This information
          may be used to show you relevant ads on Meta platforms. For customer inquiries, our server may also send hashed contact identifiers and technical information to Meta to match and measure advertising results. Hashing transforms the identifiers; it does not make them anonymous. Career applications are excluded from these customer conversion events. You can manage your ad preferences through your
          <a href="https://www.facebook.com/adpreferences" target="_blank" rel="noopener">Facebook Ad Preferences</a>.
        </p>
        <p>
          We use <strong>Google Ads conversion tracking</strong> and <strong>Microsoft Advertising UET</strong> to measure our advertising.
          Customer estimate submissions and customer phone-link clicks can send conversion events with technical and campaign information.
          These events do not contain the message you typed. Career submissions and career phone-link clicks are kept separate from customer advertising conversions.
          You can opt out of personalized advertising through your <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ads Settings</a>
          or manage Microsoft's settings at <a href="https://account.microsoft.com/privacy/ad-settings" target="_blank" rel="noopener">Microsoft privacy controls</a>.
        </p>

        <h2>Information Sharing</h2>
        <p>
          We <strong>do not sell, trade, or otherwise transfer</strong> your personal information to third parties. We may share information
          with trusted service providers who assist us in operating our website and conducting our business, as long as
          those parties agree to keep this information confidential.
        </p>

        <h2>Data Security</h2>
        <p>
          We implement <em>reasonable</em> security measures to protect your personal information. However, no method of transmission
          over the Internet is 100% secure.
        </p>

        <h2>Contact Us</h2>
        <p>
          If you have questions about this privacy policy, contact us at:
        </p>
        <p>
          <strong>{company.name}</strong><br />
          {company.address.street}<br />
          {company.address.city}, {company.address.state} {company.address.zip}<br />
          <a href={`mailto:${company.email}`}>{company.email}</a><br />
          <a href={company.phoneHref}>{company.phone}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-content h2 {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: none;
    color: var(--color-text-white);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-content p {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .prose-content ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose-content li {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 0.25rem;
  }

  .prose-content a {
    color: var(--color-green-bright);
  }

  .prose-content a:hover {
    color: var(--color-text-white);
  }
</style>
