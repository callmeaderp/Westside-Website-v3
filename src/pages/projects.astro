---
/**
 * Construction project case studies — the proof page the service funnels
 * point at. Each entry pairs a real Westside photo with the problem it solved
 * and the investment band it landed in.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import FinancingBanner from '@components/FinancingBanner.astro';
import { Image } from 'astro:assets';
import { company } from '@data/company';
import { formatBand, getBand, INVESTMENT_CAVEAT } from '@data/investment';
import { projectCategories, projects } from '@data/projects';
import { services } from '@data/services';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: siteUrl('/projects') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Westside Professional Landscape construction projects',
    itemListElement: projects.map((project, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'CreativeWork',
        name: project.title,
        description: project.solution,
        image: siteUrl(getPhoto(project.image).src),
      },
    })),
  },
];

/** Categories that actually have at least one project — no empty filters. */
const usedCategories = new Set(projects.map((p) => p.category));
const activeCategories = projectCategories.filter(
  (c) => c.value === 'all' || usedCategories.has(c.value as (typeof projects)[number]['category'])
);

const serviceName = (slug: string) => services.find((s) => s.slug === slug)?.shortName ?? 'Services';
---

<BaseLayout
  title="Hardscape & Outdoor Living Projects in Rochester, NY | Westside"
  description="Real paver patio, retaining wall, walkway, and outdoor kitchen projects built in Greater Rochester — the problem, what we built, and the typical investment range for each."
  ogImage={getPhoto('gallery-drone-patio.webp')}
  jsonLd={jsonLd}
>
  <Hero
    label="Real Completed Work"
    heading="OUR CONSTRUCTION PROJECTS IN ROCHESTER, NY"
    intro="Every project below is our own work in Greater Rochester — the problem the property had, what we built to solve it, and the range that scope typically runs."
    image={getPhoto('gallery-drone-patio.webp')}
    buttons={[
      { text: 'Start Your Project', href: '/contact/?service=hardscaping', style: 'primary' },
      { text: `Call ${company.phone}`, href: company.phoneHref, style: 'outline' },
    ]}
  />

  <section class="py-24 section-dark-alt">
    <div class="site-container-wide">
      <div class="flex flex-wrap justify-center gap-3 mb-14 fade-in">
        {activeCategories.map((cat) => (
          <button
            type="button"
            class:list={[
              'project-filter px-5 py-2 rounded-full text-sm font-semibold transition-all duration-200 cursor-pointer',
              cat.value === 'all' ? 'active' : '',
            ]}
            data-filter={cat.value}
            aria-pressed={cat.value === 'all' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8" id="project-grid">
        {projects.map((project) => {
          const band = getBand(project.investmentBandId);
          return (
            <article
              class="project-card rounded-xl overflow-hidden flex flex-col"
              data-category={project.category}
              style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);"
            >
              {project.beforeImage ? (
                <div class="grid grid-cols-2">
                  <figure class="m-0 relative">
                    <Image
                      src={getPhoto(project.beforeImage)}
                      alt={`Before: ${project.alt}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      widths={[400, 600]}
                      sizes="(max-width: 1024px) 50vw, 300px"
                    />
                    <figcaption class="absolute top-3 left-3 px-2.5 py-1 rounded text-xs font-semibold uppercase tracking-wider" style="background: rgba(0,0,0,0.7); color: #fff;">
                      Before
                    </figcaption>
                  </figure>
                  <figure class="m-0 relative">
                    <Image
                      src={getPhoto(project.image)}
                      alt={project.alt}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      widths={[400, 600]}
                      sizes="(max-width: 1024px) 50vw, 300px"
                    />
                    <figcaption class="absolute top-3 left-3 px-2.5 py-1 rounded text-xs font-semibold uppercase tracking-wider" style="background: rgba(0,134,63,0.85); color: #fff;">
                      After
                    </figcaption>
                  </figure>
                </div>
              ) : (
                <div class="aspect-[4/3] overflow-hidden">
                  <Image
                    src={getPhoto(project.image)}
                    alt={project.alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    widths={[600, 900]}
                    sizes="(max-width: 1024px) 100vw, 600px"
                  />
                </div>
              )}

              <div class="p-8 flex flex-col gap-4 flex-1">
                <div>
                  <p class="text-xs uppercase tracking-widest font-semibold mb-2" style="color: var(--color-green-bright);">
                    {project.categoryLabel}{project.town ? ` — ${project.town}` : ''}{project.year ? ` · ${project.year}` : ''}
                  </p>
                  <h2 class="text-lg" style="font-family: var(--font-body); font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    {project.title}
                  </h2>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-widest font-semibold mb-1" style="color: var(--color-text-muted);">The problem</p>
                  <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.8;">{project.problem}</p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-widest font-semibold mb-1" style="color: var(--color-text-muted);">What we built</p>
                  <p class="text-sm" style="color: var(--color-text-light); line-height: 1.8;">{project.solution}</p>
                </div>

                <div class="mt-auto pt-4 flex flex-wrap items-center justify-between gap-3" style="border-top: 1px solid var(--color-border-dark);">
                  <p class="text-sm" style="color: var(--color-text-muted);">
                    Typical range: <strong style="color: var(--color-green-bright);">{formatBand(band)}</strong>
                  </p>
                  <a href={url(`/services/${project.relatedService}/`)} class="text-sm font-semibold" style="color: var(--color-green-bright);">
                    {serviceName(project.relatedService)} &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <p id="project-empty" class="text-center text-sm mt-12 hidden" style="color: var(--color-text-muted);">
        No projects in that category yet — <a href={url('/contact/')} style="color: var(--color-green-bright);">tell us about yours</a>.
      </p>

      <div class="mt-14 p-6 rounded-xl max-w-4xl mx-auto fade-in" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
        <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.8;">
          <strong style="color: var(--color-text-light);">About these ranges.</strong> {INVESTMENT_CAVEAT}
          Photographs are our own completed Greater Rochester projects. We identify a municipality only where we can support it, so most entries are described by scope rather than by town.
        </p>
      </div>
    </div>
  </section>

  <FinancingBanner variant="full" />

  <CtaBanner
    heading='WANT SOMETHING LIKE <span style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.4); text-underline-offset: 6px;">THIS?</span>'
    text="Tell us what you're picturing and roughly what you'd like to spend. We'll walk the property and put a real number on it."
  />
</BaseLayout>

<style is:global>
  .project-filter {
    background: var(--color-bg-dark-card);
    border: 1px solid var(--color-border-dark);
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }
  .project-filter:hover {
    color: var(--color-text-white);
    border-color: var(--color-green-bright);
  }
  .project-filter.active {
    background: linear-gradient(135deg, #6cc551 0%, #00863f 100%);
    border-color: transparent;
    color: #fff;
  }
</style>

<script>
  // Category filter — plain show/hide. No animation timeouts to race, because
  // these cards are tall and a fade would leave large gaps mid-transition.
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.project-filter');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const empty = document.getElementById('project-empty');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      filterBtns.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.hidden = !show;
        if (show) visible += 1;
      });
      empty?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
