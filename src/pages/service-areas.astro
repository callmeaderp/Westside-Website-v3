---
/**
 * Service Areas page — communities served in Greater Rochester.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { company } from '@data/company';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const areas = [
  { name: 'Rochester', desc: 'Our home base on Buffalo Road. From Park Avenue to Charlotte, we know Rochester\'s neighborhoods, soil conditions, and what grows well here.' },
  { name: 'Pittsford', desc: 'Landscape design, maintenance, and hardscaping for Pittsford\'s established homes and properties. Many of our longest-running maintenance clients are here.' },
  { name: 'Webster', desc: 'Full-service landscaping for Webster\'s residential neighborhoods and commercial corridors along Route 104 and Empire Boulevard.' },
  { name: 'Penfield', desc: 'Serving Penfield homeowners since 2000 with landscape design, lawn care programs, and seasonal maintenance throughout the Four Corners area and beyond.' },
  { name: 'Fairport', desc: 'Landscape maintenance, hardscaping, and lawn treatment programs for Fairport\'s village neighborhoods and surrounding communities along the canal.' },
  { name: 'Brighton', desc: 'From Twelve Corners to Westfall Road, we provide landscape design, maintenance, and plant health services for Brighton\'s residential properties.' },
  { name: 'Greece', desc: 'Commercial and residential landscaping across Greece — including snow and ice management for businesses along Ridge Road and West Ridge.' },
  { name: 'Gates', desc: 'Just down the road from our office. Landscape maintenance, lawn care, and hardscaping for Gates homeowners and the businesses along Buffalo Road.' },
  { name: 'Chili', desc: 'Neighboring our home base in Gates, we provide the full range of landscape services to Chili\'s residential and commercial properties.' },
  { name: 'Henrietta', desc: 'Commercial landscape maintenance and snow management for Henrietta\'s business parks, retail centers, and the properties along Jefferson Road.' },
  { name: 'Victor', desc: 'Serving Victor\'s growing residential communities with landscape design, installation, and year-round property maintenance.' },
  { name: 'Spencerport', desc: 'Lawn care, landscape maintenance, and seasonal services for Spencerport families in western Monroe County.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HomeAndConstructionBusiness',
      name: company.name,
      url: company.url,
      telephone: company.phoneTel,
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.address.street,
        addressLocality: company.address.city,
        addressRegion: company.address.state,
        postalCode: company.address.zip,
        addressCountry: company.address.country,
      },
      geo: { '@type': 'GeoCoordinates', latitude: company.geo.latitude, longitude: company.geo.longitude },
      areaServed: areas.map((a) => ({
        '@type': 'City',
        name: a.name,
        containedInPlace: { '@type': 'State', name: 'New York' },
      })),
      foundingDate: String(company.foundingYear),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Service Areas', item: siteUrl('/service-areas') },
      ],
    },
  ],
};
---

<BaseLayout
  title="Service Areas | Greater Rochester NY Landscaping | Westside Professional Landscape"
  description={`Westside Professional Landscape serves ${areas.map(a => a.name).join(', ')}. Call ${company.phone}.`}
  jsonLd={jsonLd}
>
  <Hero
    label="Greater Rochester, NY"
    heading="SERVICE AREAS IN ROCHESTER, NY"
    intro="Proudly serving Monroe County and surrounding communities with full-service landscaping, lawn care, hardscaping, and property management since 2000."
    image={getPhoto('hero-services.webp')}
  />

  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {areas.map((area) => (
          <div class="p-6 rounded-xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
            <h3 class="text-base mb-2">{area.name}</h3>
            <p class="text-sm" style="color: var(--color-text-muted);">{area.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-16 fade-in">
        <p class="text-lg mb-6" style="color: var(--color-text-muted);">
          Don't see your area? We may <em>still</em> serve your location. Give us a call to find out.
        </p>
        <a href={url('/contact')} class="btn btn-primary btn-md">Contact Us</a>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
