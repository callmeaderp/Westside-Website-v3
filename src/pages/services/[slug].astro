---
import ServiceLayout from '@layouts/ServiceLayout.astro';
import FaqSection from '@components/FaqSection.astro';
import InvestmentRanges from '@components/InvestmentRanges.astro';
import ProjectProof from '@components/ProjectProof.astro';
import { Image } from 'astro:assets';
import { services, type Service } from '@data/services';
import { serviceContent } from '@data/service-content';
import type { GetStaticPaths } from 'astro';
import FinancingBanner from '@components/FinancingBanner.astro';
import { company } from '@data/company';
import { getPhoto } from '@lib/images';
import { url } from '@lib/utils';

export const getStaticPaths: GetStaticPaths = () => {
  return services
    .filter((s) => s.slug !== 'plant-health') // plant-health has its own page
    .map((service) => ({
      params: { slug: service.slug },
      props: { service },
    }));
};

const { service } = Astro.props as { service: Service };
const content = serviceContent[service.slug];
const relatedServices = (content?.relatedSlugs ?? [])
  .map((s) => services.find((svc) => svc.slug === s))
  .filter((s): s is Service => s !== undefined);
const showFinancing = company.financing.eligibleServices.includes(service.slug);
---

<ServiceLayout
  service={service}
  ctaHeading={content?.ctaHeading}
  ctaText={content?.ctaText}
  faqs={content?.faqs}
  heroButtons={content?.heroButtons}
>

  {content && (
    <section class="py-24 section-dark">
      <div class="site-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center fade-in">
          <div>
            <p class="section-label">{content.introLabel}</p>
            <h2 class="section-title" set:html={content.introTitle} />
            {content.introText.map((para) => (
              <p class="mb-6" style="color: var(--color-text-muted); line-height: 1.8;" set:html={para} />
            ))}
            {content.introCta && (
              <a href={url('/contact')} class="btn btn-primary btn-md">{content.introCta}</a>
            )}
          </div>
          <div style="border-radius: var(--radius-lg, 12px); overflow: hidden; aspect-ratio: 4/3;">
            <Image
              src={getPhoto(service.cardImage)}
              alt={service.name}
              class="w-full h-full object-cover"
              loading="lazy"
              widths={[600, 900]}
              sizes="(max-width: 1024px) 100vw, 600px"
            />
          </div>
        </div>
      </div>
    </section>
  )}

  {content?.detailCards && content.detailCards.length > 0 && (
    <section class="py-24 section-dark-alt">
      <div class="site-container">
        <div class="text-center mb-16 fade-in">
          {content.detailLabel && <p class="section-label">{content.detailLabel}</p>}
          {content.detailTitle && <h2 class="section-title" set:html={content.detailTitle} />}
          {content.detailSubtitle && <p class="section-subtitle mx-auto" set:html={content.detailSubtitle} />}
        </div>

        <div class={`grid grid-cols-1 md:grid-cols-2 gap-8 stagger-children`}>
          {content.detailCards.map((card) => (
            <div class="p-8 rounded-xl" style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);">
              <h3 class="text-base mb-4" set:html={card.title} />
              <p class="text-sm mb-6" style="color: var(--color-text-muted); line-height: 1.8;" set:html={card.text} />
              <ul class="flex flex-col gap-2">
                {card.features.map((f) => (
                  <li class="flex items-center gap-2 text-sm" style="color: var(--color-text-light);">
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {content?.processSteps && content.processSteps.length > 0 && (
    <section class="py-24 section-white">
      <div class="site-container">
        <div class="text-center mb-16 fade-in">
          {content.processLabel && <p class="section-label">{content.processLabel}</p>}
          {content.processTitle && <h2 class="section-title" set:html={content.processTitle} />}
          {content.processSubtitle && <p class="section-subtitle mx-auto" set:html={content.processSubtitle} />}
        </div>

        <div class:list={[
          'grid grid-cols-1 sm:grid-cols-2 gap-8 stagger-children',
          content.processSteps.length === 3 && 'lg:grid-cols-3',
          content.processSteps.length === 4 && 'lg:grid-cols-4',
          content.processSteps.length >= 5 && 'lg:grid-cols-5',
        ]}>
          {content.processSteps.map((step, i) => (
            <div class="text-center p-8 rounded-xl bg-bg-light border border-border-light">
              <div class="w-14 h-14 rounded-full mx-auto mb-4 flex items-center justify-center font-bold text-xl text-white" style="background: linear-gradient(135deg, #6CC551 0%, #00863F 100%);">
                {i + 1}
              </div>
              <h4 class="text-sm mb-3" style="font-family: var(--font-body); text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">{step.title}</h4>
              <p class="text-sm" style="color: var(--color-text-body-dark);" set:html={step.text} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {content?.investmentBandIds && content.investmentBandIds.length > 0 && (
    <InvestmentRanges
      bandIds={content.investmentBandIds}
      title={content.investmentTitle}
      intro={content.investmentIntro}
      serviceSlug={service.slug}
    />
  )}

  {content?.featuredProjectSlugs && content.featuredProjectSlugs.length > 0 && (
    <ProjectProof slugs={content.featuredProjectSlugs} />
  )}

  {showFinancing && <FinancingBanner variant="compact" />}

  {content?.faqs && content.faqs.length > 0 && <FaqSection faqs={content.faqs} />}

  {relatedServices.length > 0 && (
    <section class="py-24 section-dark-alt">
      <div class="site-container">
        <div class="text-center mb-16 fade-in">
          <p class="section-label">Explore More</p>
          <h2 class="section-title">RELATED SERVICES</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
          {relatedServices.map((related) => (
            <a
              href={url(`/services/${related.slug}/`)}
              class="group block rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg"
              style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);"
            >
              <div class="aspect-[16/10] overflow-hidden">
                <Image
                  src={getPhoto(related.cardImage)}
                  alt={related.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  widths={[400, 600]}
                  sizes="(max-width: 768px) 100vw, 400px"
                />
              </div>
              <div class="p-6">
                <h3 class="text-base mb-2">{related.shortName.toUpperCase()}</h3>
                <p class="text-sm" style="color: var(--color-text-muted);" set:html={related.tagline} />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</ServiceLayout>
