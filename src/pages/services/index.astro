---
/**
 * Services hub page — construction lanes surfaced first, then the full list.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { Image } from 'astro:assets';
import { constructionServices, services } from '@data/services';
import { getPhoto } from '@lib/images';
import { siteUrl } from '@lib/site';
import { url } from '@lib/utils';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Services', item: siteUrl('/services') },
  ],
};

/** Hardscaping leads the build lanes it acts as the hub for. */
const buildLanes = [
  services.find((s) => s.slug === 'hardscaping')!,
  ...constructionServices,
];
---

<BaseLayout
  title="Landscaping & Outdoor Construction Services in Rochester, NY"
  description="Paver patios, retaining walls, walkways, outdoor kitchens, drainage, landscape design, lawn care, and snow management in Rochester, NY. Serving Greater Rochester since 2000."
  jsonLd={breadcrumbJsonLd}
>
  <Hero
    label="Design, Build & Maintain"
    heading="LANDSCAPING SERVICES IN ROCHESTER, NY"
    intro="We design and build the outdoor spaces — patios, walls, entries, drainage — and then keep the property looking right, year after year."
    image={getPhoto('hero-services.webp')}
    buttons={[
      { text: 'Start Your Project', href: '/contact/', style: 'primary' },
      { text: 'See Our Projects', href: '/projects/', style: 'outline' },
    ]}
  />

  <section class="py-24 section-dark">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Design & Build</p>
        <h2 class="section-title">OUTDOOR <span class="text-green">CONSTRUCTION</span></h2>
        <p class="section-subtitle mx-auto">
          The work that changes a property. Each page publishes representative investment ranges, our build process, and real completed projects.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {buildLanes.map((service) => (
          <a
            href={url(`/services/${service.slug}/`)}
            class="group block rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg"
            style="background: var(--color-bg-dark-card); border: 1px solid var(--color-border-dark);"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <Image
                src={getPhoto(service.cardImage)}
                alt={service.cardImageAlt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                widths={[400, 600]}
                sizes="(max-width: 768px) 100vw, 400px"
              />
            </div>
            <div class="p-6">
              <h3 class="text-base mb-2">{service.shortName.toUpperCase()}</h3>
              <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.7;">{service.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 section-dark-alt">
    <div class="site-container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Everything We Do</p>
        <h2 class="section-title">FULL SERVICE <span class="text-green">LIST</span></h2>
      </div>

      <div class="flex flex-col gap-20">
        {services.map((service, i) => (
          <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${i % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
            <div class={`fade-in-${i % 2 === 0 ? 'left' : 'right'} ${i % 2 === 1 ? 'lg:col-start-2' : ''}`}>
              <Image
                src={getPhoto(service.cardImage)}
                alt={service.cardImageAlt}
                class="rounded-xl shadow-lg"
                loading="lazy"
                widths={[600, 900]}
                sizes="(max-width: 1024px) 100vw, 600px"
              />
            </div>
            <div class={`fade-in-${i % 2 === 0 ? 'right' : 'left'}`}>
              <p class="section-label">{service.tagline}</p>
              <h3 class="text-2xl mb-4">{service.name.toUpperCase()}</h3>
              <p class="mb-6" style="color: var(--color-text-muted); line-height: 1.8;">
                {service.description}
              </p>
              <a href={url(`/services/${service.slug}`)} class="btn btn-primary btn-md">
                Explore {service.shortName}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
