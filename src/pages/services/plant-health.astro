---
/**
 * Plant Health / Fertilization & Weed Control — standalone page.
 * Has unique 5-step program timeline, pricing card, and additional services
 * that don't fit the shared [slug].astro template.
 */
import ServiceLayout from '@layouts/ServiceLayout.astro';
import { getServiceBySlug } from '@data/services';
import { url } from '@lib/utils';

const service = getServiceBySlug('plant-health')!;

const programSteps = [
  {
    number: 1,
    timing: 'March — April',
    title: 'SPRING APPLICATION',
    text: 'Jump-start your lawn out of winter dormancy with a balanced fertilizer that promotes strong root development. <strong>Pre-emergent crabgrass control</strong> creates an invisible barrier that stops crabgrass seeds before they germinate. Broadleaf weed control targets any weeds that survived winter.',
    tags: ['Balanced Fertilizer', 'Pre-emergent Crabgrass', 'Weed Control'],
  },
  {
    number: 2,
    timing: 'May — June',
    title: 'LATE SPRING APPLICATION',
    text: 'A second round of balanced fertilization keeps your lawn thick and green as temperatures rise. Continued crabgrass control reinforces the spring barrier. Weed control targets new broadleaf weeds. Surface insect inspection identifies any emerging pest problems early.',
    tags: ['Balanced Fertilizer', 'Crabgrass Control', 'Weed Control', 'Insect Inspection*'],
  },
  {
    number: 3,
    timing: 'June — July',
    title: 'SUMMER APPLICATION',
    text: 'The midsummer visit sustains growth during <em>heat stress</em> with balanced nutrition. Spot treatment addresses any crabgrass that broke through the barrier. Weed control continues through peak season.',
    tags: ['Balanced Fertilizer', 'Crabgrass Spot Treatment', 'Weed Control', 'Insect Inspection*'],
    freeCallout: 'Professional grub preventive application included with this visit (June/July). Helps prevent destructive grub damage — included at no extra charge.',
  },
  {
    number: 4,
    timing: 'August — September',
    title: 'LATE SUMMER APPLICATION',
    text: "As summer winds down, this application prepares your lawn for fall recovery. Balanced fertilizer supports continued growth. Broadleaf weed control hits any late-season invaders. Surface insect inspection ensures pest populations haven't established.",
    tags: ['Balanced Fertilizer', 'Broadleaf Weed Control', 'Insect Inspection*'],
  },
  {
    number: 5,
    timing: 'October — November',
    title: 'FALL APPLICATION',
    text: 'The final visit is <strong>the most important of the season</strong>. A winterizing fertilizer promotes deep root growth that pays dividends come spring. Spot weed treatment addresses any remaining broadleaf weeds before dormancy sets in.',
    tags: ['Balanced Fertilizer', 'Spot Weed Treatment', 'Winterization'],
  },
];

const additionalServices = [
  {
    title: 'DEEP ROOT FERTILIZATION',
    text: 'Direct nutrient injection into the <strong>root zone</strong> of trees and shrubs for maximum vitality.',
    icon: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="1.5" aria-hidden="true"><path d="M7 20h10M12 20V10m0 0c0-4.5 3.5-8 8-8-1 3-2.5 5.5-4 7m-4 1c0-4.5-3.5-8-8-8 1 3 2.5 5.5 4 7"/></svg>',
  },
  {
    title: 'BED MAINTENANCE',
    text: 'Weekly weed control — both chemical and hand-picking — to keep your beds clean all season.',
    icon: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="1.5" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>',
  },
  {
    title: 'AERATION',
    text: 'Core aeration relieves soil compaction, allowing water, nutrients, and air to reach grass roots.',
    icon: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="1.5" aria-hidden="true"><path d="M12 2v6m-5-3v6m10-6v6"/><circle cx="12" cy="11" r="1.2" fill="#6CC551" stroke="none"/><circle cx="7" cy="8" r="1.2" fill="#6CC551" stroke="none"/><circle cx="17" cy="8" r="1.2" fill="#6CC551" stroke="none"/><path d="M2 16c2 0 3-1 5-1s3 1 5 1 3-1 5-1 3 1 5 1" stroke-linecap="round"/><path d="M2 20c2 0 3-1 5-1s3 1 5 1 3-1 5-1 3 1 5 1" stroke-linecap="round"/></svg>',
  },
  {
    title: 'OVERSEEDING',
    text: 'Premium grass seed application to fill in thin spots and improve lawn density and color.',
    icon: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="1.5" aria-hidden="true"><path d="M12 22V8"/><path d="M5 12l7-10 7 10"/><circle cx="5" cy="18" r="1" fill="#6CC551" stroke="none"/><circle cx="9" cy="20" r="1" fill="#6CC551" stroke="none"/><circle cx="15" cy="19" r="1" fill="#6CC551" stroke="none"/><circle cx="19" cy="17" r="1" fill="#6CC551" stroke="none"/><circle cx="7" cy="15" r="1" fill="#6CC551" stroke="none"/><circle cx="17" cy="15" r="1" fill="#6CC551" stroke="none"/></svg>',
  },
  {
    title: 'LAWN REPAIR',
    text: 'Targeted repair of damaged areas from disease, insects, or wear and tear.',
    icon: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="1.5" aria-hidden="true"><path d="M18 2l4 4-12 12-4-4z"/><path d="M2 18l4 4 12-12-4-4z"/><line x1="10" y1="10" x2="10" y2="10.01"/><line x1="14" y1="14" x2="14" y2="14.01"/><line x1="12" y1="12" x2="12" y2="12.01"/><line x1="10" y1="14" x2="10" y2="14.01"/><line x1="14" y1="10" x2="14" y2="10.01"/></svg>',
  },
  {
    title: 'DETHATCHING',
    text: 'Mechanical removal of excess thatch to restore water and nutrient penetration.',
    icon: '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="1.5" aria-hidden="true"><path d="M4 4l4 16"/><path d="M8 4l2 16"/><path d="M12 4l0 16"/><path d="M16 4l-2 16"/><path d="M20 4l-4 16"/><line x1="2" y1="4" x2="22" y2="4"/><line x1="6" y1="20" x2="18" y2="20"/></svg>',
  },
];

const pricingFeatures = [
  '5 seasonal treatments',
  'Balanced fertilization',
  'Weed & crabgrass control',
  'FREE grub control',
  'Insect inspections',
  'We stand behind our work',
];
---

<ServiceLayout
  service={service}
  ctaHeading='START YOUR JOURNEY TO A <span style="text-decoration: underline; text-decoration-color: rgba(255,255,255,0.4); text-underline-offset: 6px;">HEALTHIER LAWN</span>'
  ctaText="Schedule your <strong>free lawn evaluation</strong> today. Our experts will assess your lawn and recommend the right program for your property."
>

  <!-- ═══ VALUE PROPS ═══ -->
  <section class="py-12 section-dark-alt">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center stagger-children">
        <div class="p-6">
          <div class="text-4xl mb-2" style="font-family: var(--font-heading); color: var(--color-green-bright);">50%</div>
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-text-muted);">Off First Treatment</div>
        </div>
        <div class="p-6">
          <div class="text-4xl mb-2" style="font-family: var(--font-heading); color: var(--color-green-bright);">$116</div>
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-text-muted);">Per Treatment (Avg Lawn)</div>
        </div>
        <div class="p-6">
          <div class="text-4xl mb-2" style="font-family: var(--font-heading); color: var(--color-green-bright);">5</div>
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-text-muted);">Seasonal Visits</div>
        </div>
        <div class="p-6">
          <div class="text-4xl mb-2" style="font-family: var(--font-heading); color: #E8C84A;">FREE</div>
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-text-muted);">Grub Control Included</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 5-STEP PROGRAM ═══ -->
  <section class="py-24 section-dark" id="program-details">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-16 fade-in">

        <!-- Steps Column -->
        <div>
          <p class="section-label">The Program</p>
          <h2 class="section-title">FIVE STEPS TO A <span style="color: var(--color-green-bright);">HEALTHIER LAWN</span></h2>
          <p class="mb-10" style="color: var(--color-text-muted); line-height: 1.8;">
            <strong>Each treatment is timed</strong> to match your lawn's growth cycle. Our <strong style="color: var(--color-text-light);">NYS DEC Certified Applicators</strong> use professional-grade products that go beyond what's available at retail stores.
          </p>

          {programSteps.map((step, i) => (
            <div class="grid grid-cols-[64px_1fr] gap-8 py-8 relative" style={i < programSteps.length - 1 ? 'border-bottom: 1px solid var(--color-border-dark);' : ''}>
              <div>
                <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl relative z-10" style="background: linear-gradient(135deg, #6CC551 0%, #00863F 100%); font-family: var(--font-heading);">
                  {step.number}
                </div>
                {i < programSteps.length - 1 && (
                  <div class="absolute left-[39px] top-[80px] bottom-0 w-0.5" style="background: linear-gradient(to bottom, var(--color-green-bright), var(--color-border-dark));"></div>
                )}
              </div>
              <div>
                <div class="text-xs uppercase tracking-widest font-semibold mb-2" style="color: var(--color-green-bright);">{step.timing}</div>
                <h3 class="text-base mb-3" style="font-family: var(--font-body); text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">{step.title}</h3>
                <p class="text-sm mb-4" style="color: var(--color-text-muted); line-height: 1.7;" set:html={step.text} />
                <div class="flex flex-wrap gap-2">
                  {step.tags.map((tag) => (
                    <span class="px-3 py-1 text-xs rounded-full" style="background: rgba(108, 197, 81, 0.1); border: 1px solid rgba(108, 197, 81, 0.2); color: var(--color-green-bright);">
                      {tag}
                    </span>
                  ))}
                </div>
                {step.freeCallout && (
                  <div class="mt-4 p-4 rounded-lg flex items-center gap-4" style="background: rgba(232, 200, 74, 0.1); border: 1px solid rgba(232, 200, 74, 0.3);">
                    <span class="shrink-0 px-2.5 py-1 text-xs font-bold uppercase tracking-wider rounded-full" style="background: #E8C84A; color: var(--color-bg-dark);">FREE</span>
                    <div>
                      <strong style="color: var(--color-text-white);">FREE Grub Control</strong>
                      <div class="text-xs mt-1" style="color: var(--color-text-muted);">{step.freeCallout}</div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))}

          <p class="text-xs italic mt-8" style="color: var(--color-text-muted);">* Surface insect inspection/treatment as needed. Treatment applied when pest populations are detected at actionable levels.</p>
        </div>

        <!-- Pricing Sidebar -->
        <div>
          <div class="rounded-xl p-8 text-center sticky top-24" style="background: var(--color-bg-dark-card); border: 2px solid var(--color-green-bright);">
            <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full mb-4" style="background: linear-gradient(135deg, #6CC551 0%, #00863F 100%); color: white;">Most Popular</span>
            <h3 class="text-sm mb-1" style="font-family: var(--font-body); text-transform: uppercase; font-weight: 700;">5-STEP PROGRAM</h3>
            <div class="text-5xl mb-1" style="font-family: var(--font-heading); color: var(--color-green-bright); line-height: 1;">$116</div>
            <div class="text-xs mb-4" style="color: var(--color-text-muted);">per treatment &middot; avg lawn</div>

            <div class="rounded-lg p-3 mb-3" style="background: rgba(108, 197, 81, 0.1); border: 1px solid rgba(108, 197, 81, 0.3);">
              <strong class="text-sm" style="color: var(--color-green-bright);">50% OFF First Treatment</strong>
              <p class="text-xs mt-1" style="color: var(--color-text-muted);">Just <strong style="color: var(--color-green-bright);">$58</strong> for your first visit</p>
            </div>

            <div class="rounded-lg p-2 mb-4" style="background: rgba(232, 200, 74, 0.06); border: 1px solid rgba(232, 200, 74, 0.2);">
              <strong class="text-xs" style="color: #E8C84A;">Prepay &amp; Save 5%</strong>
            </div>

            <ul class="text-left mb-6">
              {pricingFeatures.map((f, i) => (
                <li class="flex items-center gap-2 py-1.5 text-sm" style={`color: var(--color-text-light);${i < pricingFeatures.length - 1 ? ' border-bottom: 1px solid var(--color-border-dark);' : ''}`}>
                  <span class="shrink-0" style={`color: ${f.includes('FREE') ? '#E8C84A' : 'var(--color-green-bright)'};`}>&#10003;</span>
                  <span set:html={f.includes('FREE') ? `<strong style="color: #E8C84A;">${f}</strong>` : f} />
                </li>
              ))}
            </ul>

            <a href={url('/contact')} class="btn btn-primary btn-sm w-full mb-2">Get Started Today</a>
            <a href={url('/contact')} class="btn btn-outline btn-sm w-full" style="border-color: var(--color-green-bright); color: var(--color-green-bright);">Free Evaluation</a>

            <div class="mt-4 pt-4 flex items-center justify-center gap-1.5" style="border-top: 1px solid var(--color-border-dark);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="text-xs" style="color: var(--color-text-muted);">NYS DEC Certified Applicator</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ADDITIONAL SERVICES ═══ -->
  <section class="py-24 section-accent">
    <div class="container">
      <div class="text-center mb-16 fade-in">
        <p class="section-label">Enhance Your Lawn</p>
        <h2 class="section-title">ADDITIONAL <span class="text-green">SERVICES</span></h2>
        <p class="section-subtitle mx-auto">Take your lawn to the next level with these <strong>add-on services</strong>, available individually or bundled with your 5-step program.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {additionalServices.map((svc) => (
          <div class="p-8 rounded-xl text-center" style="background: var(--color-bg-accent-card); border: 1px solid var(--color-border-accent);">
            <div class="mb-4 flex justify-center" set:html={svc.icon} />
            <h3 class="text-sm mb-3" style="font-family: var(--font-body); text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: var(--color-text-white);">{svc.title}</h3>
            <p class="text-sm" style="color: var(--color-text-muted);" set:html={svc.text} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHY US ═══ -->
  <section class="py-24 section-dark">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 rounded-xl overflow-hidden fade-in" style="border: 1px solid var(--color-border-dark);">
        <div class="aspect-[4/3] lg:aspect-auto">
          <img
            src={url('/images/photos/lawn-lush-backyard.webp')}
            alt="Lush backyard lawn treated by Westside Professional Landscape"
            class="w-full h-full object-cover"
            loading="lazy"
            width="600"
            height="400"
          />
        </div>
        <div class="p-10 lg:p-12" style="background: var(--color-bg-dark-card);">
          <p class="section-label">Why Westside</p>
          <h2 class="text-2xl mb-4">PROFESSIONAL-GRADE <span style="color: var(--color-green-bright);">RESULTS</span></h2>
          <p class="text-sm mb-6" style="color: var(--color-text-muted); line-height: 1.8;">
            There's a real difference between DIY lawn care and a <strong>professionally managed program</strong>. Here's why our clients choose Westside:
          </p>
          <ul class="flex flex-col gap-4">
            {[
              { strong: 'NYS DEC Certified Applicators', detail: 'Our technicians are properly certified and trained' },
              { strong: 'Professional-Grade Products', detail: 'Not available at retail stores — more effective and longer lasting' },
              { strong: 'Precisely Timed Treatments', detail: "Each visit is scheduled to match your lawn's growth cycle" },
              { strong: 'We Stand Behind Our Work', detail: "Not satisfied with a treatment? Contact us and we'll make it right" },
              { strong: '26+ Years Serving Rochester', detail: 'We know the local soil, climate, and grass types' },
            ].map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="#6CC551" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <div>
                  <strong class="text-sm" style="color: var(--color-text-white);">{item.strong}</strong>
                  <span class="text-xs block mt-0.5" style="color: var(--color-text-muted);">{item.detail}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</ServiceLayout>

<style>
  /* Smaller H1 to fit the longer service name */
  :global(.hero h1) {
    font-size: clamp(2.2rem, 4.2vw, 3.8rem) !important;
  }
  @media (max-width: 768px) {
    :global(.hero h1) {
      font-size: 1.7rem !important;
    }
  }
  @media (max-width: 1024px) {
    .sticky {
      position: static !important;
    }
  }
</style>
